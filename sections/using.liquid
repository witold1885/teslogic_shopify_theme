<link rel="stylesheet" href="{{ 'using.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'using-responsive.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'manuals.css' | asset_url }}" media="print" onload="this.media='all'">

<div class="using" id="using">
	<div class="using__title">How to use Screenmate Dash</div>
	<div class="using__subtitle">
		<span>Smooth start with soft installation.</span>
		<a class="using__video-show">Watch Video<img src="{{ 'chevron-right-blue.svg' | asset_url }}"></a>
	</div>
	<div class="using__video-popup">
		<div class="using__video manuals__video">
			<iframe title="Screenmate Dash Installation Guide | Tesla Model 3 (2021+)" src="https://www.youtube.com/embed/iCKNAsNVlRk" height="720" width="1280" allowfullscreen="" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" frameborder="0"></iframe>
		</div>
	</div>
	<div class="using__content">
		<div class="using__row using__row-1">
			<div class="using__row-block">
				<div class="using__row-legend-number">1</div>
				{% comment %} <div class="using__row-image using__row-image-desktop using__row-image-1"><img src="{{ 'using_1.png' | asset_url }}" srcset="{{ 'using_1-retina.png' | asset_url }} 2x" loading="lazy"></div> {% endcomment %}
				{% comment %} <div class="using__row-image using__row-image-mobile using__row-image-mobile-1"><img src="{{ 'using_1_mobile.png' | asset_url }}" srcset="{{ 'using_1_mobile-retina.png' | asset_url }} 2x" loading="lazy"></div> {% endcomment %}
				<div class="using__row-image using__row-image-desktop using__row-image-1"><img src="{{ 'using_1.svg' | asset_url }}"></div>
				<div class="using__row-image using__row-image-mobile using__row-image-mobile-1"><img src="{{ 'using_1.svg' | asset_url }}"></div>
			</div>
			<div class="using__row-legend-text">Connect a small Screenmate Dash<br>transmitter to your vehicle.</div>
		</div>

		<div class="using__row using__row-2">
			<div class="using__row-block">
				<div class="using__row-legend-number">2</div>
				{% comment %} <div class="using__row-image using__row-image-desktop using__row-image-2"><img src="{{ 'using_2.png' | asset_url }}" srcset="{{ 'using_2-retina.png' | asset_url }} 2x" loading="lazy"></div> {% endcomment %}
				{% comment %} <div class="using__row-image using__row-image-mobile using__row-image-mobile-2"><img src="{{ 'using_2_mobile.png' | asset_url }}" srcset="{{ 'using_2_mobile-retina.png' | asset_url }} 2x" loading="lazy"></div> {% endcomment %}
				<div class="using__row-image using__row-image-desktop using__row-image-2"><img src="{{ 'using_2.svg' | asset_url }}"></div>
				<div class="using__row-image using__row-image-mobile using__row-image-mobile-2"><img src="{{ 'using_2.svg' | asset_url }}"></div>
			</div>
			<div class="using__row-legend-text">Install magnetic phone holder<br>with optional charger.</div>
		</div>

		<div class="using__row using__row-3">
			<div class="using__row-block">
				<div class="using__row-legend-number">3</div>
				{% comment %} <div class="using__row-image using__row-image-desktop using__row-image-3"><img src="{{ 'using_3.png' | asset_url }}" srcset="{{ 'using_3-retina.png' | asset_url }} 2x" loading="lazy"></div> {% endcomment %}
				{% comment %} <div class="using__row-image using__row-image-mobile using__row-image-mobile-3"><img src="{{ 'using_3_mobile.png' | asset_url }}" srcset="{{ 'using_3_mobile-retina.png' | asset_url }} 2x" loading="lazy"></div> {% endcomment %}
				<div class="using__row-image using__row-image-desktop using__row-image-3"><img src="{{ 'using_3.svg' | asset_url }}"></div>
				<div class="using__row-image using__row-image-mobile using__row-image-mobile-3"><img src="{{ 'using_3.svg' | asset_url }}"></div>
			</div>
			<div class="using__row-legend-text">Run Screenmate Dash app on your<br>iPhone, iPad or any Android device.</div>
		</div>
		
		<div class="using__row using__row-4">
			<div class="using__row-block">
				<div class="using__row-legend-number">4</div>
				{% comment %} <div class="using__row-image using__row-image-desktop using__row-image-4"><img src="{{ 'using_4.png' | asset_url }}" srcset="{{ 'using_4-retina.png' | asset_url }} 2x" loading="lazy"></div> {% endcomment %}
				{% comment %} <div class="using__row-image using__row-image-mobile using__row-image-mobile-4"><img src="{{ 'using_4_mobile.png' | asset_url }}" srcset="{{ 'using_4_mobile-retina.png' | asset_url }} 2x" loading="lazy"></div> {% endcomment %}
				<div class="using__row-image using__row-image-desktop using__row-image-4"><img src="{{ 'using_4.svg' | asset_url }}"></div>
				<div class="using__row-image using__row-image-mobile using__row-image-mobile-4"><img src="{{ 'using_4.svg' | asset_url }}"></div>
			</div>
			<div class="using__row-legend-text">Turn your phone into a convenient<br>and functional dashboard.</div>
		</div>
	</div>
</div>

<script type="text/javascript">
$(document).ready(function() {
	var videoShow = false

	$('.using__video-show').on('click', function() {
		$('.using__video-popup').css('display', 'flex')
		videoShow = true
	})

	$('.using__video-popup').on('click', function (e) {
	    if (videoShow && $(e.target).closest('.using__video').length === 0) {
	        $('.using__video-popup').hide()
	        videoShow = false
	    }
	})
})
</script>
