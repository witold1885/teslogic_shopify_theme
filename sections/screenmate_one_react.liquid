<div id="react-screenmate-one-root"></div>

<script>
  (function() {
    var fullUrl = "{{ 'missing-marker.js' | asset_url }}"
    var cdnPath = fullUrl.split('?')[0].replace('missing-marker.js', '')

    var manifestUrl = "{{ 'manifest.json' | asset_url }}"
    var entryPoint = "src/pages/ScreenmateOne.tsx"

    fetch(manifestUrl)
      .then(function(res) { return res.json() })
      .then(function(manifest) {
        var imports = {}
        
        Object.keys(manifest).forEach(function(key) {
          var item = manifest[key]
          imports["./" + item.file] = cdnPath + item.file
          imports[item.file] = cdnPath + item.file
        })

        var im = document.createElement('script')
        im.type = 'importmap'
        im.textContent = JSON.stringify({ imports: imports })
        document.head.appendChild(im)

        var mainEntry = manifest[entryPoint]
        var script = document.createElement('script')
        script.type = 'module'
        script.src = cdnPath + mainEntry.file
        script.defer = true
        document.body.appendChild(script)
      })
  })()
</script>
