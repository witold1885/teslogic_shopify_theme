<div id="react-screenmate-one-root"></div>

<script>
  (function() {
    var fullUrl = "{{ 'missing-marker.js' | asset_url }}"
    var cdnPath = fullUrl.split('?')[0].replace('missing-marker.js', '')
    window.__shopify_assets_url__ = cdnPath

    var manifestUrl = "{{ 'manifest.json' | asset_url }}"
    var entryPoint = "ScreenmateOne-react.tsx"

    fetch(manifestUrl)
      .then(function(res) { 
        if (!res.ok) throw new Error('Статус відповіді сервера: ' + res.status)
        return res.json()
      })
      .then(function(manifest) {
        var mainEntry = manifest[entryPoint]
        if (!mainEntry) return

        if (mainEntry.css) {
          mainEntry.css.forEach(function(cssFile) {
            var link = document.createElement('link')
            link.rel = 'stylesheet'
            link.href = cdnPath + cssFile
            document.head.appendChild(link)
          })
        }

        if (mainEntry.imports) {
          mainEntry.imports.forEach(function(chunkPath) {
            var chunkEntry = manifest[chunkPath]
            if (chunkEntry) {
              var link = document.createElement('link')
              link.rel = 'modulepreload'
              link.href = cdnPath + chunkEntry.file
              document.head.appendChild(link)
            }
          })
        }

        var script = document.createElement('script')
        script.type = 'module'
        script.src = cdnPath + mainEntry.file
        script.defer = true
        document.body.appendChild(script)
      })
      .catch(function(err) {
        console.error('Cannot load Vite manifest:', err)
      })
  })()
</script>
