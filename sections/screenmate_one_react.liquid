<div id="react-screenmate-one-root"></div>

{{ 'ScreenmateOne.css' | asset_url | stylesheet_tag }}

{%- capture main_menu -%}
  {% render 'menu-json', menu_handle: 'main-menu' %}
{%- endcapture -%}

{%- capture product -%}
  {% render 'product-json', product: all_products['teslogic-screenmate'] %}
{%- endcapture -%}

{% comment %} {% assign product = all_products['teslogic-screenmate'] %}
{% assign charger = all_products['screenmate-wireless-charger'] %}
{% assign splitter = all_products['screenmate-splitter'] %} {% endcomment %}

<script>
  console.log('{{ product }}')
  window.ShopifyReactData = {
    content: {
      main_menu: {{ main_menu }},
      footer_menu: []
    },
    product: {{ product }},
    // additionalProducts: [
    //   {{ charger }},
    //   {{ splitter }}
    // ]
  }
</script>

<script src="{{ 'ScreenmateOne.js' | asset_url }}" type="module" defer></script>
