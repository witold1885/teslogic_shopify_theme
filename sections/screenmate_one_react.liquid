<div id="react-screenmate-one-root"></div>

{{ 'react-style-ScreenmateOne-Cazq1ORO.css' | asset_url | stylesheet_tag }}

{%- capture countries -%}
  {% render 'countries-json' %}
{%- endcapture -%}

{%- capture localization_country -%}
  {% render 'country-json', country: localization.country %}
{%- endcapture -%}

{%- capture main_menu -%}
  {% render 'menu-json', menu_handle: 'main-menu' %}
{%- endcapture -%}

{%- capture cart -%}
  {% render 'cart-json' %}
{%- endcapture -%}

{%- capture product -%}
  {% render 'product-json', product: all_products['teslogic-screenmate'] %}
{%- endcapture -%}

{%- capture charger -%}
  {% render 'product-json', product: all_products['screenmate-wireless-charger'] %}
{%- endcapture -%}

{%- capture splitter -%}
  {% render 'product-json', product: all_products['screenmate-splitter'] %}
{%- endcapture -%}

<script>
  {%- assign cache_buster = theme.id | append: '-' | append: 'now' | date: '%s' -%}
  const countries = {{ countries }}
  const localization_country = {{ localization_country }}
  const country = countries.some(({ iso_code }) => iso_code === localization_country.iso_code) ? localization_country : countries[0]
  window.ShopifyReactData = {
    publicPath: "{{ 'react-marker.txt' | asset_url | split: 'react-marker.txt' | first | append: '?v=' | append: cache_buster }}",
    content: {
      country,
      countries,
      main_menu: {{ main_menu }},
      footer_menu: []
    },
    cart: {{ cart }},
    product: {{ product }},
    additionalProducts: [{{ charger }}, {{ splitter }}]
  }
</script>

<script src="{{ 'ScreenmateOne.js' | asset_url }}" type="module" defer></script>
