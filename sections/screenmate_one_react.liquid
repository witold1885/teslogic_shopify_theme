<div id="react-screenmate-one-root"></div>

{{ 'ScreenmateOne.css' | asset_url | stylesheet_tag }}

{%- capture main_menu -%}
  [
    {%- for link in linklists.main-menu.links -%}
      {
        "title": {{ link.title | json }},
        "url": {{ link.url | json }},
        "children": [
          {%- if link.links != blank -%}
            {%- for child_link in link.links -%}
              {
                "title": {{ child_link.title | json }},
                "url": {{ child_link.url | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        ]
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
{%- endcapture -%}

{% assign product = all_products['teslogic-screenmate'] %}
{% assign charger = all_products['screenmate-wireless-charger'] %}
{% assign splitter = all_products['screenmate-splitter'] %}

<script>
  window.ShopifyReactData = {
    main_menu: {{ main_menu }}
  }
</script>

<script src="{{ 'ScreenmateOne.js' | asset_url }}" type="module" defer></script>
