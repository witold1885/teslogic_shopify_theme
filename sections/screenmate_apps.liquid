<style type="text/css">
    .screenmate-apps {
        background: #F6F6F6;
        margin: 0 auto;
        padding: 180px 0 212px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .screenmate-apps-wrap {
        width: 1076px;
        display: flex;
        flex-direction: column;
        row-gap: 40px;
    }
    .screenmate-apps-title {
        display: flex;
        align-items: center;
        column-gap: 24px;
    }
    .screenmate-apps-title div {
        color: var(--Black, #0F0F0F);
        font-family: Manrope;
        font-size: 52px;
        font-style: normal;
        font-weight: 500;
        line-height: 64px;
    }
    .screenmate-apps-title img {
        width: 48px;
        height: 52px;
    }
    .screenmate-apps-body {
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        row-gap: 24px;
    }
    .screenmate-apps-collage {
        width: 100%;
        height: 581px;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .screenmate-apps-collage > div {
        position: absolute;
    }
    .screenmate-apps-collage-background {
        width: 100%;
        height: 517px;
        bottom: 0;
        z-index: 1;
        border-radius: 40px 40px 64px 64px;
        background: url({{ 'screenmate_apps_background.png' | asset_url }}) lightgray -2406.935px -596.701px / 436.885% 354.49% no-repeat;
        background-size: cover;
        background-position: center;
    }
    .screenmate-apps-collage-image {
        width: 1028px;
        height: 557px;
        top: 0;
        z-index: 2;
        border-radius: 40px;
        background: url({{ 'screenmate_apps_image.png' | asset_url }}) lightgray 50% / contain no-repeat;
        background-size: cover;
        background-position: center;
    }
    .screenmate-apps-features {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
    }
    .screenmate-apps-feature {
        position: relative;
        width: 526px;
        height: 226px;
        padding: 28px 32px;
        border-radius: 24px;
        border: 1px solid #E0E0E0;
        background: #FFF;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        row-gap: 12px;
        overflow: hidden;
    }
    .screenmate-apps-feature-title {
        color: #000;
        font-family: Manrope;
        font-size: 24px;
        font-style: normal;
        font-weight: 500;
        line-height: 32px;
    }
    .screenmate-apps-feature-description {
        color: #666;
        font-family: Manrope;
        font-size: 18px;
        font-style: normal;
        font-weight: 400;
        line-height: 24px;
    }
    .screenmate-apps-feature-01 .screenmate-apps-feature-description {
        width: 262px;
    }
    .screenmate-apps-feature-02 .screenmate-apps-feature-description {
        width: 238px;
    }
    .screenmate-apps-feature-03 .screenmate-apps-feature-description {
        width: 273px;
    }
    .screenmate-apps-feature-04 .screenmate-apps-feature-description {
        width: 262px;
    }
    .screenmate-apps-feature-05 .screenmate-apps-feature-description {
        width: 262px;
    }
    .screenmate-apps-feature-06 .screenmate-apps-feature-description {
        width: 262px;
    }
    .screenmate-apps-feature img {
        position: absolute;
    }
    .screenmate-apps-feature-01 img {
        top: 0;
        right: 0;
    }
    .screenmate-apps-feature-02 img {
        top: 3px;
        right: 37px;
    }
    .screenmate-apps-feature-03 img {
        top: 44px;
        right: 35px;
    }
    .screenmate-apps-feature-04 img {
        top: 44px;
        right: 37px;
    }
    .screenmate-apps-feature-05 img {
        top: 44px;
        right: 39px;
    }
    .screenmate-apps-feature-06 img {
        top: 32px;
        right: 41px;
    }
</style>

{% assign features = blogs['screenmate-apps'].articles | sort: 'title' %}

<div class="screenmate-apps">
    <div class="screenmate-apps-wrap">
        <div class="screenmate-apps-title">
            <div>Any App at Your Fingertips</div>
            <img src="{{ 'playmarket.svg' | asset_url }}">
        </div>
        <div class="screenmate-apps-body">
            <div class="screenmate-apps-collage">
                <div class="screenmate-apps-collage-background"></div>
                <div class="screenmate-apps-collage-image"></div>
            </div>
            <div class="screenmate-apps-features">
		        {% for feature in features %}
                    {% assign title_array = feature.title | split: ' ' %}
                    {% assign number = title_array.first %}
                    {% assign title = feature.title | replace: number, '' %}
                    <div class="screenmate-apps-feature screenmate-apps-feature-{{ number }}">
                        <div class="screenmate-apps-feature-title">{{ title }}</div>
                        <div class="screenmate-apps-feature-description">{{ feature.content }}</div>
                        <img src="{{ feature.image | img_url }}" alt="{{ title }}">
                    </div>
	    	    {% endfor %}
            </div>
        </div>
    </div>
</div>
