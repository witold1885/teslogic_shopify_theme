<style type="text/css">
    .screenmate-apps {
        background: #F6F6F6;
        margin: 0 auto;
        padding: 180px 0 212px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .screenmate-apps-wrap {
        width: 1076px;
        display: flex;
        flex-direction: column;
        row-gap: 40px;
    }
    .screenmate-apps-title {
        display: flex;
        align-items: center;
        column-gap: 24px;
    }
    .screenmate-apps-title div {
        color: var(--Black, #0F0F0F);
        font-family: Manrope;
        font-size: 52px;
        font-style: normal;
        font-weight: 500;
        line-height: 64px;
    }
    .screenmate-apps-title img {
        width: 48px;
        height: 52px;
    }
    .screenmate-apps-body {
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        row-gap: 24px;
    }
    .screenmate-apps-collage {
        width: 100%;
        height: 581px;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .screenmate-apps-collage > div {
        position: absolute;
    }
    .screenmate-apps-collage-background {
        width: 100%;
        height: 517px;
        bottom: 0;
        z-index: 1;
        border-radius: 40px 40px 64px 64px;
        background: url({{ 'screenmate_apps_background.png' | asset_url }}) lightgray -2406.935px -596.701px / 436.885% 354.49% no-repeat;
        background-size: cover;
        background-position: center;
    }
    .screenmate-apps-collage-image {
        width: 1028px;
        height: 557px;
        top: 0;
        z-index: 2;
        border-radius: 40px;
        background: url({{ 'screenmate_apps_image.png' | asset_url }}) lightgray 50% / contain no-repeat;
        background-size: cover;
        background-position: center;
    }
    .screenmate-apps-features {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
    }
    .screenmate-apps-feature {
        width: 526px;
        height: 226px;
        border-radius: 24px;
        position: relative;
        border: 1px solid #E0E0E0;
        background: #FFF;
    }
</style>

{% capture features_json %}
  [ 
    {
        "title": "Entertainment", 
        "description": "Access your favorite streaming services directly from your Tesla's screen. Watch movies, TV shows, and more with smooth, high-quality playback.", 
        "image": "screenmate_apps_feature_1.svg"
    },
    {
        "title": "Navigation", 
        "description": "Utilize popular navigation apps like Google Maps, Waze, and others.", 
        "image": "screenmate_apps_feature_2.svg"
    },
    {
        "title": "Stay Connected", 
        "description": "Effortless access to social media, emails, video calls, and messaging apps—Screenmate keeps you in touch on the go.", 
        "image": "screenmate_apps_feature_3.svg"
    },
    {
        "title": "Music", 
        "description": "Seamless access to your favorite music apps. Enjoy high-quality streaming from popular services, bringing your playlists to life on your Tesla.", 
        "image": "screenmate_apps_feature_4.svg"
    },
    {
        "title": "Mobile Gaming", 
        "description": "Experience the thrill of mobile gaming directly on your Tesla. Access a variety of exciting games available through Google Play Games.", 
        "image": "screenmate_apps_feature_5.svg"
    },
    {
        "title": "Anything Else", 
        "description": "Transform your Tesla into a versatile hub with Teslogic Screenmate, giving you effortless access to a wide range of applications.", 
        "image": "screenmate_apps_feature_6.svg"
    }
  ]
{% endcapture %}

{% assign features = "" | split: "," %}
{% assign features = features | push: "Entertainment||Access your favorite streaming services directly from your Tesla's screen. Watch movies, TV shows, and more with smooth, high-quality playback.||screenmate_apps_feature_1.svg" %}
{% assign features = features | push: "Navigation||Utilize popular navigation apps like Google Maps, Waze, and others.||screenmate_apps_feature_2.svg" %}
{% assign features = features | push: "Stay Connected||Effortless access to social media, emails, video calls, and messaging apps—Screenmate keeps you in touch on the go.||screenmate_apps_feature_3.svg" %}


<div class="screenmate-apps">
    <div class="screenmate-apps-wrap">
        <div class="screenmate-apps-title">
            <div>Any App at Your Fingertips</div>
            <img src="{{ 'playmarket.svg' | asset_url }}">
        </div>
        <div class="screenmate-apps-body">
            <div class="screenmate-apps-collage">
                <div class="screenmate-apps-collage-background"></div>
                <div class="screenmate-apps-collage-image"></div>
            </div>
            <div class="screenmate-apps-features">
                {% for feature in features %}
                    {% assign parts = feature | split: "||" %}
                    <div class="screenmate-apps-feature">
                        <h2>{{ parts[0] }}</h2>
                        <p>{{ parts[1] }}</p>
                        <img src="{{ parts[2] | asset_url }}" alt="{{ parts[0] }}">
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
