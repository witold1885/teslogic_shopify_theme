{% assign features_desktop = blogs['screenmate-apps'].articles | sort: 'title' %}
{% assign features_mobile = blogs['screenmate-apps-mobile'].articles | sort: 'title' %}

<div class="screenmate-apps">
    <div class="screenmate-apps-wrap">
        <div class="screenmate-apps-title">
            <div>Any App at Your Fingertips</div>
            <img src="{{ 'playmarket.svg' | asset_url }}">
        </div>
        <div class="screenmate-apps-body">
            <div class="screenmate-apps-collage">
                <div class="screenmate-apps-collage-background"></div>
                <div class="screenmate-apps-collage-image"></div>
            </div>
            <div class="screenmate-apps-features-desktop">
		        {% for feature in features_desktop %}
                    {% assign title_array = feature.title | split: ' ' %}
                    {% assign number = title_array.first %}
                    {% assign title = feature.title | replace: number, '' %}
                    <div class="screenmate-apps-feature screenmate-apps-feature-{{ number }}">
                        <div class="screenmate-apps-feature-title">{{ title }}</div>
                        <div class="screenmate-apps-feature-description">{{ feature.content }}</div>
                        <img src="{{ feature.image | img_url }}" alt="{{ title }}">
                        {% if number == '02' %}
                            <div class="screenmate-apps-feature-navigation-icons">
                                <img src="{{ 'screenmate_apps_navigation_icon_1.svg' | asset_url }}" alr="">
                                <img src="{{ 'screenmate_apps_navigation_icon_2.svg' | asset_url }}" alr="">
                                <img src="{{ 'screenmate_apps_navigation_icon_2.svg' | asset_url }}" alr="">
                            </div>
	    	            {% endif %}
                    </div>
	    	    {% endfor %}
            </div>
            <div class="screenmate-apps-features-mobile">
		        {% for feature in features_mobile %}
                    {% assign title_array = feature.title | split: ' ' %}
                    {% assign number = title_array.first %}
                    {% assign title = feature.title | replace: number, '' %}
                    <div class="screenmate-apps-feature screenmate-apps-feature-{{ number }}">
                        <div class="screenmate-apps-feature-title">{{ title }}</div>
                        <div class="screenmate-apps-feature-description">{{ feature.content }}</div>
                        <img src="{{ feature.image | img_url }}" alt="{{ title }}">
                    </div>
	    	    {% endfor %}
            </div>
        </div>
    </div>
</div>
