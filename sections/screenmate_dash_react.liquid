{% render 'banner-screenmate-dash' %}

<div id="react-screenmate-dash-root"></div>

{% render 'seo-screenmate-dash' %}

{{ 'react-style-ScreenmateDash-CyXBH9gM.css' | asset_url | stylesheet_tag }}

{%- capture localization_country -%}
  {% render 'country-json', country: localization.country %}
{%- endcapture -%}

{%- capture main_menu -%}
  {% render 'menu-json', menu_handle: 'main-menu' %}
{%- endcapture -%}

{%- capture cart -%}
  {% render 'cart-json' %}
{%- endcapture -%}

{% assign blogs = "significant-dashboard-features,performance-driv-ing-modes,safety-stability-features,convenien-ce-comfort,autopilot-tweaks-beta" | split: ',' %}
{% assign imageSize = '48x48' %}

{%- capture features -%}
  {
    {% for blog in blogs %}
      {% if blog == 'significant-dashboard-features' %}
        {% assign imageSize = '848x848' %}
      {% endif %}
      {%- capture blockFeatures -%}
        {% render 'features-json', blog: blog, imageSize: imageSize %}
      {%- endcapture -%}
      "{{ blog }}": {{ blockFeatures }}
      {%- unless forloop.last -%},{%- endunless -%}
    {% endfor %}
  }
{%- endcapture -%}

{%- capture videos -%}
  {% render 'videos-json', blog: 'bloggers-about-teslogic' %}
{%- endcapture -%}

{%- capture product -%}
  {% render 'product-json', product: all_products['screenmate-dash-kit'] %}
{%- endcapture -%}

{%- capture charger -%}
  {% render 'product-json', product: all_products['screenmate-wireless-charger'] %}
{%- endcapture -%}

<script>
  {%- assign cache_buster = theme.id | append: '-' | append: 'now' | date: '%s' -%}
  const videos = {{ videos }}
  window.ShopifyReactData = {
    publicPath: "{{ 'react-marker.txt' | asset_url | split: 'react-marker.txt' | first | append: '?v=' | append: cache_buster }}",
    content: {
      country: {{ localization_country }},
      main_menu: {{ main_menu }},
      footer_menu: [],
      features: {{ features }},
      videos: videos.map(({ body_html, summary_html }) => ({ url: body_html.trim(), html: summary_html }))
    },
    cart: {{ cart }},
    product: {{ product }},
    additionalProducts: [{{ charger }}]
  }
</script>

<script src="{{ 'ScreenmateDash.js' | asset_url }}" type="module" defer></script>
