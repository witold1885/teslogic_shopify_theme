<div id="react-screenmate-dash-root"></div>

{% render 'seo-screenmate-dash' %}

{{ 'react-style-ScreenmateDash-BTx_WKKC.css' | asset_url | stylesheet_tag }}

{%- capture localization_country -%}
  {% render 'country-json', country: localization.country %}
{%- endcapture -%}

{%- capture main_menu -%}
  {% render 'menu-json', menu_handle: 'main-menu' %}
{%- endcapture -%}

{%- capture cart -%}
  {% render 'cart-json' %}
{%- endcapture -%}

{% assign blocks = "significant-dashboard-features,performance-driv-ing-modes,safety-stability-features,convenien-ce-comfort,autopilot-tweaks-beta" | split: ',' %}

{%- capture features -%}
  {
    {% for block in blocks %}
      {%- capture blockFeatures -%}
        {% render 'features-json', blog: block, imageSize: '48x48' %}
      {%- endcapture -%}
      "{{ block }}": {{ blockFeatures }}
      {%- unless forloop.last -%},{%- endunless -%}
    {% endfor %}
  }
{%- endcapture -%}

{%- capture product -%}
  {% render 'product-json', product: all_products['screenmate-dash-kit'] %}
{%- endcapture -%}

{%- capture charger -%}
  {% render 'product-json', product: all_products['screenmate-wireless-charger'] %}
{%- endcapture -%}

{%- capture splitter -%}
  {% render 'product-json', product: all_products['screenmate-splitter'] %}
{%- endcapture -%}

<script>
  {%- assign cache_buster = theme.id | append: '-' | append: 'now' | date: '%s' -%}
  window.ShopifyReactData = {
    publicPath: "{{ 'react-marker.txt' | asset_url | split: 'react-marker.txt' | first | append: '?v=' | append: cache_buster }}",
    content: {
      country: {{ localization_country }},
      main_menu: {{ main_menu }},
      footer_menu: [],
      features: {{ features }}
    },
    cart: {{ cart }},
    product: {{ product }},
    additionalProducts: [{{ charger }}, {{ splitter }}]
  }
</script>

<script src="{{ 'ScreenmateDash.js' | asset_url }}" type="module" defer></script>
