<style>
  .static-content {
    position: relative;
    max-width: 856px !important;
    margin: 0 auto;
    padding: 116px 0 150px;
    color: #000;
    font-family: Manrope;
    font-style: normal;
  }
  .static-content * {
    margin: 0;
    padding: 0;
  }
  .static-content strong {
    font-weight: 500 !important;
  }
  .static-content h2 {
    font-size: 52px;
    font-weight: 500;
    line-height: 64px;
    text-transform: capitalize;
    margin-bottom: 12px;
  }
  .static-content h2:not(:first-of-type) {
    margin-top: 80px;
  }
  .static-content > p,
  .static-content > ol,
  .static-content > ul {
    background: #F6F6F6;
    padding: 0 32px;
  }
  .static-content h2 + p {
    font-size: 24px;
    font-weight: 500;
    line-height: 32px;
    opacity: 0.6;
    margin-bottom: 40px;
    padding: 0;
    background: transparent;
  }
  .static-content h2 + p em {
    font-style: normal;
  }
  .static-content > ol, .static-content > ul {
    list-style-position: inside;
  }
  .static-content > ol {
    padding-top: 32px;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
  }
  .static-content > ol[start] {
    padding-top: 80px;
    border-top-left-radius: unset;
    border-top-right-radius: unset;
  }
  .static-content > ol h3, .static-content > ul p {
    display: inline;
  }
  .static-content > p, .static-content > ul {
    padding-top: 16px;
  }
  .static-content > p:has(+ ol:not([start])),
  .static-content > ul + p:has(+ ul) {
    display: none;
  }
  .static-content > ul:has(+ ol[start]),
  .static-content > p:has(+ ol[start]) {
    height: 0;
    padding-top: 40px;
    border-bottom: 2px solid #D9D9D9;
    position: absolute;
    left: 32px;
    right: 32px;
  }
  .static-content > ol + p, .static-content > ol + ul {
    padding-top: 20px;
  }
  .static-content > br {
    display: none;
  }
  .static-content > p:has(+ h2),
  .static-content > *:last-child {
    height: 0;
    padding-top: 0;
    padding-bottom: 32px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
  }
  .static-content ol li {
    font-size: 32px;
    font-weight: 500;
    line-height: 40px;
    text-transform: capitalize;
  }
  .static-content ol li h3 {
    font-size: inherit !important;
  }
  .static-content p, .static-content ul li {
    color: #404040;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
  }
  .static-content p strong {
    color: #111;
  }
  .static-content p.subchapter strong {
    color: #000;
    font-size: 24px;
    font-weight: 500;
    line-height: 32px;
    text-transform: capitalize;
  }
  .static-content p.list_item {
    display: list-item;
    list-style: inside;
  }
  .static-content a {
    color: #1657FC;
    text-decoration: none;
  }
  @media screen and (min-width: 576px) and (max-width: 1440px) {
    .static-content {
      max-width: calc(856 * 100vw / 1440) !important;
      padding: calc(116 * 100vw / 1440) 0 calc(150 * 100vw / 1440);
    }
    .static-content h2 {
      font-size: calc(52 * 100vw / 1440);
      line-height: calc(64 * 100vw / 1440);
      margin-bottom: calc(12 * 100vw / 1440);
    }
    .static-content h2:not(:first-of-type) {
      margin-top: calc(80 * 100vw / 1440);
    }
    .static-content > p,
    .static-content > ol,
    .static-content > ul {
      padding: 0 calc(32 * 100vw / 1440);
    }
    .static-content h2 + p {
      font-size: calc(24 * 100vw / 1440);
      line-height: calc(32 * 100vw / 1440);
      margin-bottom: calc(40 * 100vw / 1440);
    }
    .static-content > ol {
      padding-top: calc(32 * 100vw / 1440);
      border-top-left-radius: calc(24 * 100vw / 1440);
      border-top-right-radius: calc(24 * 100vw / 1440);
    }
    .static-content > ol[start] {
      padding-top: calc(80 * 100vw / 1440);
    }
    .static-content > p, .static-content > ul {
      padding-top: calc(16 * 100vw / 1440);
    }
    .static-content > ul:has(+ ol[start]),
    .static-content > p:has(+ ol[start]) {
      padding-top: calc(40 * 100vw / 1440);
      left: calc(32 * 100vw / 1440);
      right: calc(32 * 100vw / 1440);
    }
    .static-content > ol + p, .static-content > ol + ul {
      padding-top: calc(20 * 100vw / 1440);
    }
    .static-content > p:has(+ h2),
    .static-content > *:last-child {
      padding-bottom: calc(32 * 100vw / 1440);
      border-bottom-left-radius: calc(24 * 100vw / 1440);
      border-bottom-right-radius: calc(24 * 100vw / 1440);
    }
    .static-content ol li {
      font-size: calc(32 * 100vw / 1440);
      line-height: calc(40 * 100vw / 1440);
    }
    .static-content p, .static-content ul li {
      font-size: calc(16 * 100vw / 1440);
      line-height: calc(24 * 100vw / 1440);
    }
    .static-content p.subchapter strong {
      font-size: calc(24 * 100vw / 1440);
      line-height: calc(32 * 100vw / 1440);
    }
  }
  @media screen and (max-width: 575px) {
    .static-content {
      max-width: calc(335 * 100vw / 375) !important;
      padding: calc(16 * 100vw / 375) 0 calc(96 * 100vw / 375);
    }
    .static-content h2 {
      font-size: calc(32 * 100vw / 375);
      line-height: calc(40 * 100vw / 375);
      margin-bottom: calc(12 * 100vw / 375);
    }
    .static-content h2:not(:first-of-type) {
      margin-top: calc(80 * 100vw / 375);
    }
    .static-content > p,
    .static-content > ol,
    .static-content > ul {
      padding: 0 calc(16 * 100vw / 375);
    }
    .static-content h2 + p {
      font-size: calc(18 * 100vw / 375);
      line-height: calc(24 * 100vw / 375);
      margin-bottom: calc(40 * 100vw / 375);
    }
    .static-content > ol {
      padding-top: calc(16 * 100vw / 375);
      border-top-left-radius: calc(16 * 100vw / 375);
      border-top-right-radius: calc(16 * 100vw / 375);
    }
    .static-content > ol[start] {
      padding-top: calc(48 * 100vw / 375);
    }
    .static-content > p, .static-content > ul {
      padding-top: calc(16 * 100vw / 375);
    }
    .static-content > ul:has(+ ol[start]),
    .static-content > p:has(+ ol[start]) {
      padding-top: calc(24 * 100vw / 375);
      left: calc(16 * 100vw / 375);
      right: calc(16 * 100vw / 375);
    }
    .static-content > ol + p, .static-content > ol + ul {
      padding-top: calc(16 * 100vw / 375);
    }
    .static-content > p:has(+ h2),
    .static-content > *:last-child {
      padding-bottom: calc(16 * 100vw / 375);
      border-bottom-left-radius: calc(16 * 100vw / 375);
      border-bottom-right-radius: calc(16 * 100vw / 375);
    }
    .static-content ol li {
      font-size: calc(18 * 100vw / 375);
      line-height: calc(24 * 100vw / 375);
    }
    .static-content p, .static-content ul li {
      font-size: calc(16 * 100vw / 375);
      line-height: calc(24 * 100vw / 375);
    }
    .static-content p.subchapter strong {
      font-size: calc(18 * 100vw / 1440);
      line-height: calc(24 * 100vw / 1440);
    }
  }
</style>

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <div class="rte static-content">
    {{ page.content }}
  </div>
</div>

<script type="text/javascript">
  const rules = {
    subchapter: /^\d+\.\d+\s/,
    list_item: /^(\p{Lu}+)\s/u
  }

  $(document).ready(function() {
    $('.static-content > p').each(function() {
      const text = $(this).text().trim()
      if (text) {
        for (const rule in rules) {
          if (rules[rule].test(text)) {
            $(this).addClass(rule)
          }
        }
      }
    })
  })
</script>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
