<style>
  .static-content {
    max-width: 856px !important;
    margin: 0 auto;
    padding: 116px 0 150px;
    color: #000;
    font-family: Manrope;
    font-style: normal;
  }
  .static-content * {
    margin: 0;
    padding: 0;
  }
  .static-content h2 {
    font-size: 52px;
    font-weight: 500;
    line-height: 64px; /* 123.077% */
    text-transform: capitalize;
    margin-bottom: 12px;
  }
  .static-content h2 + p {
    font-size: 24px;
    font-weight: 500;
    line-height: 32px; /* 133.333% */
    opacity: 0.6;
    margin-bottom: 40px;
  }
  .static-content p:not(:first-child),
  .static-content ol {
    background: #F6F6F6;
    padding: 0 32px;
  }
  .static-content ol {
    list-style-position: inside;
    padding-bottom: 20px;
  }
  .static-content ol h3 {
    display: inline;
  }
  .static-content > ol:first-child {
    padding-top: 40px;
  }
</style>

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <!-- <h1 class="main-page-title page-title h0">
    {{ page.title | escape }}
  </h1> -->
  <div class="rte static-content">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
