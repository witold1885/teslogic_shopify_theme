<style>
  .static-content {
    position: relative;
    max-width: 856px !important;
    margin: 0 auto;
    padding: 116px 0 150px;
    color: #000;
    font-family: Manrope;
    font-style: normal;
  }
  .static-content * {
    margin: 0;
    padding: 0;
  }
  .static-content strong {
    font-weight: 500 !important;
  }
  .static-content h2 {
    font-size: 52px;
    font-weight: 500;
    line-height: 64px;
    text-transform: capitalize;
    margin-bottom: 12px;
  }
  .static-content h2:not(:first-of-type) {
    margin-top: 80px;
  }
  .static-content > p,
  .static-content > ol,
  .static-content > ul {
    background: #F6F6F6;
    padding: 0 32px;
  }
  .static-content h2 + p {
    font-size: 24px;
    font-weight: 500;
    line-height: 32px;
    opacity: 0.6;
    margin-bottom: 40px;
    padding: 0;
    background: transparent;
  }
  .static-content h2 + p em {
    font-style: normal;
  }
  .static-content > ol, .static-content > ul {
    list-style-position: inside;
  }
  .static-content > ol {
    padding-top: 32px;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
  }
  .static-content > ol[start] {
    padding-top: 80px;
    border-top-left-radius: unset;
    border-top-right-radius: unset;
  }
  .static-content > ol h3, .static-content > ul p {
    display: inline;
  }
  .static-content > p, .static-content > ul {
    padding-top: 16px;
  }
  .static-content > p:has(+ ol:first-of-type) {
    display: none;
  }
  .static-content > ul:has(+ ol:not(:first-of-type)),
  .static-content > p:has(+ ol:not(:first-of-type)) {
    height: 0;
    padding-top: 40px;
    border-bottom: 2px solid #D9D9D9;
    position: absolute;
    left: 32px;
    right: 32px;
  }
  .static-content > ol + p, .static-content > ol + ul {
    padding-top: 20px;
  }
  .static-content > br {
    display: none;
  }
  .static-content > p:has(+ h2),
  .static-content > *:last-child {
    height: 0;
    padding-top: 0;
    padding-bottom: 32px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
  }
  .static-content ol li {
    font-size: 32px;
    font-weight: 500;
    line-height: 40px;
    text-transform: capitalize;
  }
  .static-content p, .static-content ul li {
    color: #404040;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
  }
  .static-content p strong {
    color: #111;
  }
  .static-content a {
    color: #1657FC;
    text-decoration: none;
  }
</style>

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <div class="rte static-content">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
