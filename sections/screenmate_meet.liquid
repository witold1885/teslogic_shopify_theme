<style type="text/css">
    .screenmate-meet {
        background: #FBFBFB;
        margin: 0 auto;
        padding: 136px 0;
        display: flex;
        justify-content: center;
        align-items: center;
        row-gap: 40px;
    }
    .screenmate-meet-wrap {
        width: 1076px;
        display: flex;
        flex-direction: column;
        row-gap: 40px;
    }
    .screenmate-meet-title {
        width: 980px;
        color: var(--Black, #0F0F0F);
        font-family: Manrope;
        font-size: 52px;
        font-style: normal;
        font-weight: 500;
        line-height: 64px;
    }
    .screenmate-meet-body {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
        row-gap: 48px;
    }
    .screenmate-meet-video-wrap {
        width: 1076px;
        height: 605px;
        border-radius: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: url({{ 'sreenmate_meet_video.png' | asset_url }}), lightgray -201.326px -148.057px / 135.562% 135.618% no-repeat;
        background-size: cover;
        background-position: center;
        box-shadow: 0px 4px 64px 0px rgba(0, 0, 0, 0.24);
        overflow: hidden;
    }
    .screenmate-meet-video-play {
        width: 192px;
        height: 192px;
        cursor: pointer
    }
    .screenmate-meet-video-play img {
        width: 100%;
        height: 100%;
    }
    .screenmate-meet-video-data {
        display: none;
    }
    .screenmate-meet-kickstarter {
        display: flex;
        align-items: center;
        column-gap: 6px;
    }
    .screenmate-meet-kickstarter-text {
        color: #9A9A9A;
        text-align: center;
        font-family: Manrope;
        font-size: 24px;
        font-style: normal;
        font-weight: 400;
        line-height: 32px;
    }
    .screenmate-meet-kickstarter-logo {
        width: 201px;
        height: 24px;
    }
    .screenmate-meet-kickstarter-logo img {
        width: 100%;
    }
</style>

<script type="text/javascript">
    $(document).ready(function() {
        $('.screenmate-meet-video-play').on('click', function () {
            const videoSrc = 'https://www.youtube.com/embed/_Xa4kt9xD3Y?autoplay=1'
            $('#youtube-video').attr('src', videoSrc)
            $('.screenmate-meet-video-data').show()
        })
    })
</script>

<div class="screenmate-meet">
    <div class="screenmate-meet-wrap">
        <div class="screenmate-meet-title">
            Meet Teslogic Screenmate, a device that transforms your Tesla's screen
        </div>
        <div class="screenmate-meet-body">
            <div class="screenmate-meet-video-wrap">
                <div class="screenmate-meet-video-play">
                    <img src="{{ 'screenmate_meet_yt_play.svg' | asset_url }}">
                </div>
                <div class="screenmate-meet-video-data">
                    <iframe
                        id="youtube-video"
                        width="1076"
                        height="605"
                        src=""
                        title="Teslogic Screenmate: the Ultimate Extra Computer for your Tesla"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                    ></iframe>
                </div>
            </div>
            <div class="screenmate-meet-kickstarter">
                <div class="screenmate-meet-kickstarter-text">Trusted by over 1300 bakers on</div>
                <div class="screenmate-meet-kickstarter-logo">
                    <img src="{{ 'screenmate_meet_kickstarter_logo.png' | asset_url }}">
                </div>
            </div>
        </div>
    </div>
</div>
