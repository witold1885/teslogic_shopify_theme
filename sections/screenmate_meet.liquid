<style type="text/css">
    .screenmate-meet {
        background: #FBFBFB;
        margin: 0 auto;
        padding: 136px 0;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .screenmate-meet-wrap {
        width: 1076px;
        display: flex;
        flex-direction: column;
        row-gap: 40px;
    }
    .screenmate-meet-title {
        width: 980px;
        color: var(--Black, #0F0F0F);
        font-family: Manrope;
        font-size: 52px;
        font-style: normal;
        font-weight: 500;
        line-height: 64px;
    }
    .screenmate-meet-body {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
        row-gap: 48px;
    }
    .screenmate-meet-video-wrap {
        width: 1076px;
        height: 605px;
        border-radius: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: url({{ 'sreenmate_meet_video.png' | asset_url }}), lightgray -201.326px -148.057px / 135.562% 135.618% no-repeat;
        background-size: cover;
        background-position: center;
        box-shadow: 0px 4px 64px 0px rgba(0, 0, 0, 0.24);
        overflow: hidden;
    }
    .screenmate-meet-video-play {
        width: 192px;
        height: 192px;
        cursor: pointer
    }
    .screenmate-meet-video-play img {
        width: 100%;
        height: 100%;
    }
    .screenmate-meet-video-data {
        display: none;
    }
    .screenmate-meet-video-data iframe {
        width: 1076px;
        height: 605px;
    }
    .screenmate-meet-kickstarter {
        display: flex;
        align-items: center;
        column-gap: 6px;
    }
    .screenmate-meet-kickstarter-text {
        color: #9A9A9A;
        text-align: center;
        font-family: Manrope;
        font-size: 24px;
        font-style: normal;
        font-weight: 400;
        line-height: 32px;
    }
    .screenmate-meet-kickstarter-logo {
        width: 201px;
        height: 24px;
    }
    .screenmate-meet-kickstarter-logo img {
        width: 100%;
    }
	@media screen and (min-width: 576px) and (max-width: 1440px) {
        .screenmate-meet {
            padding: calc(136 * 100vw / 1440) 0;
        }
        .screenmate-meet-wrap {
            width: calc(1076 * 100vw / 1440);
            row-gap: calc(40 * 100vw / 1440);
        }
        .screenmate-meet-title {
            width: calc(980 * 100vw / 1440);
            font-size: calc(52 * 100vw / 1440);
            line-height: calc(64 * 100vw / 1440);
        }
        .screenmate-meet-body {
            row-gap: calc(48 * 100vw / 1440);
        }
        .screenmate-meet-video-wrap {
            width: calc(1076 * 100vw / 1440);
            height: calc(605 * 100vw / 1440);
            border-radius: calc(40 * 100vw / 1440);
            box-shadow: 0px calc(4 * 100vw / 1440) calc(64 * 100vw / 1440) 0px rgba(0, 0, 0, 0.24);
        }
        .screenmate-meet-video-play {
            width: calc(192 * 100vw / 1440);
            height: calc(192 * 100vw / 1440);
        }
        .screenmate-meet-video-data iframe {
            width: calc(1076 * 100vw / 1440);
            height: calc(605 * 100vw / 1440);
        }
        .screenmate-meet-kickstarter {
            column-gap: calc(6 * 100vw / 1440);
        }
        .screenmate-meet-kickstarter-text {
            font-size: calc(24 * 100vw / 1440);
            line-height: calc(32 * 100vw / 1440);
        }
        .screenmate-meet-kickstarter-logo {
            width: calc(201 * 100vw / 1440);
            height: calc(24 * 100vw / 1440);
        }
    }
    @media screen and (max-width: 575px) {
        .screenmate-meet {
            padding: calc(96 * 100vw / 375) 0;
        }
        .screenmate-meet-wrap {
            width: calc(335 * 100vw / 375);
            row-gap: calc(24 * 100vw / 375);
        }
        .screenmate-meet-title {
            width: calc(335 * 100vw / 375);
            font-size: calc(32 * 100vw / 375);
            line-height: calc(40 * 100vw / 375);
        }
        .screenmate-meet-body {
            row-gap: calc(20 * 100vw / 375);
        }
        .screenmate-meet-video-wrap {
            width: calc(335 * 100vw / 375);
            height: calc(189 * 100vw / 375);
            border-radius: calc(24 * 100vw / 375);
            box-shadow: 0px calc(4 * 100vw / 375) calc(64 * 100vw / 375) 0px rgba(0, 0, 0, 0.24);
        }
        .screenmate-meet-video-play {
            width: calc(128 * 100vw / 375);
            height: calc(128 * 100vw / 375);
        }
        .screenmate-meet-video-data iframe {
            width: calc(335 * 100vw / 375);
            height: calc(189 * 100vw / 375);
        }
        .screenmate-meet-kickstarter {
            flex-direction: column;
            row-gap: calc(6 * 100vw / 375);
        }
        .screenmate-meet-kickstarter-text {
            font-size: calc(16 * 100vw / 375);
            line-height: calc(20 * 100vw / 375);
        }
        .screenmate-meet-kickstarter-logo {
            width: calc(134 * 100vw / 375);
            height: calc(16 * 100vw / 375);
        }
    }
</style>

<script type="text/javascript">
    $(document).ready(function() {
        $('.screenmate-meet-video-play').on('click', function () {
            const videoSrc = 'https://www.youtube.com/embed/_Xa4kt9xD3Y?autoplay=1'
            $('#youtube-video').attr('src', videoSrc)
            $('.screenmate-meet-video-data').show()
        })
    })
</script>

<div class="screenmate-meet">
    <div class="screenmate-meet-wrap">
        <div class="screenmate-meet-title">
            Meet Teslogic Screenmate, a device that transforms your Tesla's screen
        </div>
        <div class="screenmate-meet-body">
            <div class="screenmate-meet-video-wrap">
                <div class="screenmate-meet-video-play">
                    <img src="{{ 'screenmate_meet_yt_play.svg' | asset_url }}">
                </div>
                <div class="screenmate-meet-video-data">
                    <iframe
                        id="youtube-video"
                        src=""
                        title="Teslogic Screenmate: the Ultimate Extra Computer for your Tesla"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                    ></iframe>
                </div>
            </div>
            <div class="screenmate-meet-kickstarter">
                <div class="screenmate-meet-kickstarter-text">Trusted by over 1300 bakers on</div>
                <a
                    class="screenmate-meet-kickstarter-logo"
                    href="https://www.kickstarter.com/projects/teslogic/screenmate-the-ultimate-extra-computer-for-your-tesla"
                    target="_blank"
                >
                    <img src="{{ 'screenmate_meet_kickstarter_logo.svg' | asset_url }}">
                </a>
            </div>
        </div>
    </div>
</div>
