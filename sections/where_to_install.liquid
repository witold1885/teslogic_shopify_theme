<link rel="stylesheet" href="{{ 'where_to_install.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'where_to_install-responsive.css' | asset_url }}" media="print" onload="this.media='all'">

{% assign articles = blogs['where-to-install'].articles | sort: "id" %}

<div class="where">
	<div class="where__top">
		<div class="where__title">Where to install</div>
		<div class="where__subtitle">
			While Screenmate devices are easy to install, you can always contact our partners who can handle the installation for you.
		</div>
	</div>
	<div class="where__body">
	    {% for article in articles %}
			{% assign blog_lines = article.content | split: "</p>" %}
			{% assign latlng = '' %}
			<div class="where__item">
				<div class="where__item-left">
					<div class="where__item-info">
						<div class="where__item-title">{{ article.title }}</div>
						<div class="where__item-data">
							{% for line in blog_lines %}
								{% assign line = line | remove: "<p>" | strip %}
								{% if line != "" %}
									{% assign parts = line | split:":" %}
									{% assign key = parts[0] | remove: "<p>" | strip %}
									{% if key != 'address' and key != 'latlng' %}
										{% assign value = parts[1] | remove: "<p>" | strip %}
										<div class="where__item-data-item">
											<div class="where__item-data-item-key">{{ key }}:</div>
											<div class="where__item-data-item-value">
												{% if key == 'site' %}
													<a href="https://{{ value }}/" target="_blank">{{ value }}</a>
												{% else %}
													{{ value }}
												{% endif %}
											</div>
										</div>
									{% endif %}
								{% endif %}
							{% endfor %}
						</div>
					</div>
					<div class="where__item-image">
						<img draggable="false" src="{{ article.image | img_url: '250x250' }}">
					</div>
				</div>
				<div class="where__item-right">
					<div class="where__item-info">
						<div class="where__item-data">
							{% assign num = 0 %}
							{% for line in blog_lines %}
								{% assign line = line | remove: "<p>" | strip %}
								{% if line != "" %}
									{% assign parts = line | split:":" %}
									{% assign key = parts[0] | remove: "<p>" | strip %}
									{% if key == 'address' %}
										{% assign num = num | plus: 1 %}
										{% assign value = parts[1] | remove: "<p>" | strip %}
										<div class="where__item-data-item where__item-data-item-address">
											<div class="where__item-data-item-key">{{ key }} №{{ num }}:</div>
											<div class="where__item-data-item-value">{{ value }}</div>
										</div>
									{% endif %}
								{% endif %}
							{% endfor %}
						</div>
					</div>
					<div class="where__item-maps">
						{% for line in blog_lines %}
							{% assign line = line | remove: "<p>" | strip %}
							{% if line != "" %}
								{% assign parts = line | split:":" %}
								{% assign key = parts[0] | remove: "<p>" | strip %}
								{% if key == 'latlng' %}
									{% assign value = parts[1] | remove: "<p>" | strip %}
									<div class="where__item-map">
										<iframe
											width="281"
											height="76"
											style="border:0"
											loading="lazy"
											allowfullscreen
											src="https://www.google.com/maps/embed/v1/place?key=AIzaSyAqbo5rx2oVhWCW_pSzNrWnywQSRSdlnQ4&q={{ value }}&zoom=15">
										</iframe>
									</div>
								{% endif %}
							{% endif %}
						{% endfor %}
					</div>
				</div>				
			</div>
	  	{% endfor %}
	</div>
</div>
