<link rel="stylesheet" type="text/css" href="{{ 'header_screenmate.css' | asset_url }}">
<link rel="stylesheet" type="text/css" href="{{ 'header_screenmate-responsive.css' | asset_url }}">
<link rel="stylesheet" type="text/css" href="{{ 'subscription-popup.css' | asset_url }}">
<link rel="stylesheet" type="text/css" href="{{ 'screenmate-promo-popup.css' | asset_url }}">

{%- style -%}
  .banner-desktop-wrap {
    background: url({{ 'bg_screenmate.png' | asset_url }});
    background-size: cover;
    background-position: center;
  }

  .banner {
    background: url({{ 'bg_screenmate_mobile.png' | asset_url }});
    background-position: top center;
    background-repeat: no-repeat;
    background-size: cover;
  }
{%- endstyle -%}

<div id="subscription-popup" class="subscription-popup-shadow">
  <div class="subscription-popup">
    <div class="subscription-popup-close">
      <img src="{{ 'subscription_popup_close.svg' | asset_url }}" alt="">
    </div>
    <div class="subscription-popup-side subscription-popup-left">
      <img class="image-desktop" src="{{ 'subscription_popup_image.png' | asset_url }}" alt="">
      <img class="image-mobile" src="{{ 'subscription_popup_image_mobile.png' | asset_url }}" alt="">
    </div>
    <div class="subscription-popup-side subscription-popup-right">
      <div class="subscription-popup-head">
        <div class="subscription-popup-logo">
          <img src="{{ 'subscription_popup_logo.svg' | asset_url }}" alt="">
        </div>
        <div class="subscription-popup-info">
          <div class="subscription-popup-title">
            Your first <span>10%</span><br><span>discount</span> Is on Us!
          </div>
          <div class="subscription-popup-subtitle">
            Join Teslogic Community and get best <br>
            deals and exclusive updates.
          </div>
        </div>
      </div>
      <div class="subscription-popup-form">
        <div class="subscription-popup-fields">
          <div class="subscription-popup-field">
            <label>Name:</label>
            <input class="subscription-popup-name" type="text" placeholder="Enter your name">
            <span class="subscription-popup-field-error-message"></span>
          </div>
          <div class="subscription-popup-field">
            <label>E-mail:</label>
            <input class="subscription-popup-email" type="email" placeholder="John.smith@example.com">
            <span class="subscription-popup-field-error-message"></span>
          </div>
        </div>
        <div class="subscription-popup-buttons">
          <button class="subscription-popup-submit">Unlock my discount</button>
          <div class="subscription-popup-cancel">
            No, I want to pay full price.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="success-popup" class="subscription-popup-shadow">
  <div class="success-popup">
    <div class="success-popup-close">
      <img src="{{ 'subscription_popup_close.svg' | asset_url }}" alt="">
    </div>
    <div class="subscription-popup-logo">
      <img src="{{ 'subscription_popup_logo.svg' | asset_url }}" alt="">
    </div>
    <div class="subscription-popup-info">
      <div class="subscription-popup-title">
        <span>Thank you</span> for subscribing
      </div>
      <div class="subscription-popup-subtitle">
        The discount is waiting <br>
        for you already in the e-mail.
      </div>
    </div>
  </div>
</div>

<div id="promo-popup" class="promo-popup-shadow">
  <div class="promo-popup">
    <div class="promo-popup-close">
      <img src="{{ 'subscription_popup_close.svg' | asset_url }}" alt="">
    </div>
    <div class="promo-popup-side promo-popup-left">
      <img class="image-desktop" src="{{ 'screenmate_promo_popup_image.png' | asset_url }}" alt="">
      <img class="image-mobile" src="{{ 'screenmate_promo_popup_image_mobile.png' | asset_url }}" alt="">
    </div>
    <div class="promo-popup-side promo-popup-right">
      <div class="promo-popup-main">
        <div class="promo-popup-logo">
          <img src="{{ 'subscription_popup_logo.svg' | asset_url }}" alt="">
        </div>
        <div class="promo-popup-info">
          This Christmas, <br>
          <span>save 33%</span> on <br>
          Screenmate!
        </div>
        <div class="promo-popup-code">
          <div>Use code</div>
          <div class="promo-popup-code-placeholder">
            <div class="promo-popup-code-placeholder-text">SCRGIFT</div>
            <div class="promo-popup-code-placeholder-icon promo-popup-code-placeholder-icon-copy">
              <img src="{{ 'promo_copy.svg' | asset_url }}">
            </div>
            <div class="promo-popup-code-placeholder-icon promo-popup-code-placeholder-icon-copied">
              <img src="{{ 'promo_copied.svg' | asset_url }}">
            </div>
          </div>
          <div>at checkout.</div>
        </div>
      </div>
      <div class="promo-popup-buttons">
        <div class="promo-popup-cancel">
          Thanks, I don’t want a discount.
        </div>
      </div>
    </div>
  </div>
</div>

<header id="header_main" class="header-screenmate">
  <div class="top-wrap">
    <div class="top">
      <a href="/" class="logo">
        <img src="{{ 'logo.svg' | asset_url }}">
      </a>
      <div class="menu">
        {% for link in linklists.main-menu.links %}
        {% if link.title != 'Community' %}
          <div
            class="menu__item {% if link.title == 'Teslogic Pro' or link.title == 'Screenmate' %}menu__item-pro{% endif %} {% if link.title == 'Buy Now' %}menu__item-button{% endif %}"
            {% if link.title == 'Buy Now' and cart.item_count != 0 %} style="display: none;" {% endif %}
          >
            <a href="{{ link.url }}">{{ link.title }} {% if link.title == 'Teslogic Pro' or link.title == 'Screenmate' %}<span>NEW</span>{% endif %}</a>
            {% if link.links.size > 0 or link.title == 'Accessories' %}
              <img class="menu__item-chevron menu__item-chevron-down" src="{{ 'chevron-down.svg' | asset_url }}">
              <img class="menu__item-chevron menu__item-chevron-up" src="{{ 'chevron-up-grey.svg' | asset_url }}">
              {% if link.title == 'Accessories' %}
                <ul class="menu__item-dropdown">
                  {% for product in collections['all'].products %}
                    {% if product.handle != 'teslogic-transmitter-kit' and product.handle != 'teslogic-transmitter-kit-v2' and product.handle != 'teslogic-pro-boost-transmitter-kit' and product.handle != 'teslogic-pro-performace-transmitter-kit' %}
                      <li class="menu__item-dropdown-link">
                        <a href="/products/{{ product.handle }}">{{ product.title }}</a>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              {% else %}
                <ul class="menu__item-dropdown">
                  {% for child_link in link.links %}
                    <li class="menu__item-dropdown-link">
                      <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            {% endif %}
          </div>
        {% endif %}
        {% endfor %}
        <div 
          class="menu__item menu__item-cart"
          {% if cart.item_count == 0 %} style="display: none;" {% endif %}
        >
          <a href="/cart">
            <div class="cart-icon-wrap">
              <img src="{{ 'cart-white.svg' | asset_url }}">
              <div class="cart-qty">{{ cart.item_count }}</div>
            </div>
            <span>Cart</span>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="header_main-fix"></div>
  <div class="banner-desktop-wrap">
    <div class="banner-desktop">
        {% comment %} <div class="banner-desktop-ellipse"></div> {% endcomment %}
        <div class="banner-desktop-body">
            <div class="banner-desktop-body-device">
                <img src="{{ 'sreenmate_banner_device.png' | asset_url }}">
            </div>
            <div class="banner-desktop-body-caption">
                <div class="banner-desktop-body-caption-left">
                    <div class="banner-desktop-body-caption-main">
                        <img src="{{ 'screenmate_banner_logo.svg' | asset_url }}">
                        <a href="#shop-now">Preorder now</a>
                    </div>
                    <div class="banner-desktop-body-caption-subtitle">
                        The Ultimate Tesla Multimedia Upgrade
                    </div>
                </div>
                <div class="banner-desktop-body-caption-kickstarter">
                    <img src="{{ 'screenmate_banner_kickstarter.png' | asset_url }}">
                </div>
            </div>
        </div>
    </div>
  </div>
</header>
