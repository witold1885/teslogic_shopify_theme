{%- style -%}
  .promo-bg {
    background-image: url({{ 'bg_new_year_promo.png' | asset_url }});
  }
  @media screen and (max-width: 575px) {
    .promo-bg {
      background-image: url({{ 'bg_new_year_promo_mobile.png' | asset_url }});
    }
  }
  header#header_main {
    height: 100vh;
  }
  .banner-desktop-wrap {
    background: url({{ 'bg_2x.png' | asset_url }});
    background-size: cover;
    background-position-x: center;
    background-repeat: no-repeat; 
    height: 100%;
  }
  .banner-desktop {
    height: 100%;
  }
  @media screen and (min-width: 1701px) { 
    .banner-desktop-wrap {
      background: url({{ 'bg_2x.png' | asset_url }});
      background-size: cover;
      /*background-position: right 20% center;*/
      background-position: right center;
      background-repeat: no-repeat; 
    }
  }
  @media screen and (min-width: 1251px) and (max-width: 1366px) {  
    .banner-desktop-wrap {
/*      background-size: 1366px 768px;*/
    }      
  }
  .banner {
/*    background: url({{ 'bg_mobile_2x.png' | asset_url }});*/
/*    background-position: right calc(-1 * (830px - 100vw) / 2) center;*/
    background: linear-gradient(0deg, #070A08 23.08%, rgba(7, 10, 8, 0.00) 34.36%), linear-gradient(180deg, #070A08 5.73%, rgba(7, 10, 8, 0.00) 31.94%), url({{ 'bg_mobile_2x.png' | asset_url}}), lightgray -768.819px -107.262px / 371.789% 96.682% no-repeat; 
/*    background: url({{ 'bg_mobile_2x.png' | asset_url }}), lightgray -91.807px -318.013px / 131.806% 139.158% no-repeat; */
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }
{%- endstyle -%}

<header id="header_main">
  <div class="promo-bg">
    <div class="promo-wrap">
      <div class="promo-close">
        <img src="{{ 'promo_close.svg' | asset_url }}">
      </div>
      <div class="promo">
        <div class="promo-info">GET 15% OFF</div>
        <div class="promo-code">
          <div class="promo-code-info">Use code</div>
          <div class="promo-code-placeholder promo-code-placeholder-copied">
            <div class="promo-code-placeholder-text">TSLGIFT15</div>
            <div class="promo-code-placeholder-icon promo-code-placeholder-icon-copy">
              <img src="{{ 'promo_copy.svg' | asset_url }}">
            </div>
            <div class="promo-code-placeholder-icon promo-code-placeholder-icon-copied">
              <img src="{{ 'promo_copied.svg' | asset_url }}">
            </div>
          </div>
        </div>
        <div class="promo-counter">
          <div class="promo-counter-item">
            <div class="promo-counter-item-value promo_days">--</div>
            <div class="promo-counter-item-caption">days</div>
          </div>
          <div class="promo-counter-delimiter">:</div>
          <div class="promo-counter-item">
            <div class="promo-counter-item-value promo_hours">--</div>
            <div class="promo-counter-item-caption">hrs</div>
          </div>
          <div class="promo-counter-delimiter">:</div>
          <div class="promo-counter-item">
            <div class="promo-counter-item-value promo_minutes">--</div>
            <div class="promo-counter-item-caption">mins</div>
          </div>
          <div class="promo-counter-delimiter">:</div>
          <div class="promo-counter-item">
            <div class="promo-counter-item-value promo_seconds">--</div>
            <div class="promo-counter-item-caption">secs</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="top-wrap">
    <div class="top">
      <a href="/" class="logo">
        <img src="{{ 'logo.svg' | asset_url }}">
      </a>
      <div class="menu">
        {% for link in linklists.main-menu.links %}
        {% if link.title != 'Community' %}
          <div
            class="menu__item {% if link.title == 'Teslogic Pro' or link.title == 'Screenmate' %}menu__item-pro{% endif %} {% if link.title == 'Buy Now' %}menu__item-button{% endif %}"
            {% if link.title == 'Buy Now' and cart.item_count != 0 %} style="display: none;" {% endif %}
          >
            <a href="{{ link.url }}">{{ link.title }} {% if link.title == 'Teslogic Pro' or link.title == 'Screenmate' %}<span>NEW</span>{% endif %}</a>
            {% if link.links.size > 0 or link.title == 'Accessories' %}
              <img class="menu__item-chevron menu__item-chevron-down" src="{{ 'chevron-down.svg' | asset_url }}">
              <img class="menu__item-chevron menu__item-chevron-up" src="{{ 'chevron-up-grey.svg' | asset_url }}">
              {% if link.title == 'Accessories' %}
                <ul class="menu__item-dropdown">
                  {% for product in collections['all'].products %}
                    {% if product.handle != 'teslogic-transmitter-kit' and product.handle != 'teslogic-transmitter-kit-v2' and product.handle != 'teslogic-pro-boost-transmitter-kit' and product.handle != 'teslogic-pro-performace-transmitter-kit' and product.handle != 'teslogic-screenmate' %}
                      <li class="menu__item-dropdown-link">
                        <a href="/products/{{ product.handle }}">{{ product.title }}</a>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              {% else %}
                <ul class="menu__item-dropdown">
                  {% for child_link in link.links %}
                    <li class="menu__item-dropdown-link">
                      <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            {% endif %}
          </div>
        {% endif %}
        {% endfor %}
        <div 
          class="menu__item menu__item-cart"
          {% if cart.item_count == 0 %} style="display: none;" {% endif %}
        >
          <a href="/cart">
            <div class="cart-icon-wrap">
              <img src="{{ 'cart-white.svg' | asset_url }}">
              <div class="cart-qty">{{ cart.item_count }}</div>
            </div>
            <span>Cart</span>
          </a>
        </div>      
      </div>
    </div>
  </div>
  <div class="header_main-fix"></div>
  {% render 'black_friday', position: 'desktop' %}
  <div class="banner-desktop-wrap" id="main_banner">
    <div class="banner-desktop">
      <div class="title">Meet Teslogic v2</div>
