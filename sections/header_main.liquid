<!-- Black Friday Timer Script -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/1.19.1/TweenMax.min.js"></script>
<script type="text/javascript">
    let endDatetime = '2025-11-30T23:59:59';
    TweenLite.defaultEase = Expo.easeOut;

    initTimer(endDatetime);
    $(window).on('resize', () => initTimer(endDatetime));

    function getTimeLeft (targetDate) {
        const now = new Date();
        const target = new Date(targetDate);
        let diff = Math.max(0, target - now);

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        diff -= days * 1000 * 60 * 60 * 24;

        const hours = Math.floor(diff / (1000 * 60 * 60));
        diff -= hours * 1000 * 60 * 60;

        const minutes = Math.floor(diff / (1000 * 60));
        diff -= minutes * 1000 * 60;

        const seconds = Math.floor(diff / 1000);

        return { days, hours, minutes, seconds };
    }

    function initTimer (targetDate) {
        const position = window.innerWidth >= 575 ? 'desktop' : 'mobile';
        const timerEl = document.querySelector(`.timer-${position}`);

        const groups = {
            days: {
                first: timerEl.querySelector('.days-group .first'),
                second: timerEl.querySelector('.days-group .second'),
            },
            hours: {
                first: timerEl.querySelector('.hrs-group .first'),
                second: timerEl.querySelector('.hrs-group .second'),
            },
            minutes: {
                first: timerEl.querySelector('.mins-group .first'),
                second: timerEl.querySelector('.mins-group .second'),
            },
            seconds: {
                first: timerEl.querySelector('.secs-group .first'),
                second: timerEl.querySelector('.secs-group .second'),
            }
        };

        function animateDigit(el, val) {
            TweenMax.killTweensOf(el.querySelector('.number-grp-wrp'));
            TweenMax.to(el.querySelector('.number-grp-wrp'), 1, {
                y: -el.querySelector('.num-' + val).offsetTop
            });
        }

        function update() {
            const t = getTimeLeft(targetDate);

            const d = String(t.days).padStart(2, "0");
            const h = String(t.hours).padStart(2, "0");
            const m = String(t.minutes).padStart(2, "0");
            const s = String(t.seconds).padStart(2, "0");

            animateDigit(groups.days.first,     d[0]);
            animateDigit(groups.days.second,    d[1]);

            animateDigit(groups.hours.first,    h[0]);
            animateDigit(groups.hours.second,   h[1]);

            animateDigit(groups.minutes.first,  m[0]);
            animateDigit(groups.minutes.second, m[1]);

            animateDigit(groups.seconds.first,  s[0]);
            animateDigit(groups.seconds.second, s[1]);

            if (t.days === 0 && t.hours === 0 && t.minutes === 0 && t.seconds === 0) {
                return;
            }

            setTimeout(update, 1000);
        }

        update();
    }

    $(document).ready(function () {
        $('.black-friday-expand').on('click', function (e) {
            if ($(this).attr('href') != '#') {
                e.preventDefault()
                $('.burger-menu-wrap').hide()
                $('.button-close').hide()
                $('html, body').animate({
                    scrollTop: $($(this).attr('href')).offset().top
                }, 500)
            }
        })
    })
</script>
<!-- Black Friday Timer Script -->
  
<script type="text/javascript">
  // console.log('userAgent')
  // console.log(window.navigator.userAgent)
  // console.log(window.innerWidth)
  // console.log(window.innerHeight)
  var logo_white_url = "{{ 'logo.svg' | asset_url }}"
  // var logo_black_url = "{{ 'logo_black.svg' | asset_url }}"
  var chevron_white = "{{ 'chevron-down.svg' | asset_url }}"
  // var chevron_black = "{{ 'chevron-down-black.svg' | asset_url }}"
  // console.log(logo_white_url)
  // console.log(logo_black_url)
  $(document).ready(function() {
    /* promo script */
    const endTime = 1734940800 // 23.12.2024 08:00 UTC

    function addLeadingZero(value) {
      return value < 10 ? '0' + value : value
    }

    function updateCountdown() {
      const currentTime = Math.floor(Date.now() / 1000)
      const timeLeft = endTime - currentTime

      if (timeLeft >= 0) {
        const days = Math.floor(timeLeft / (24 * 60 * 60))
        const hours = Math.floor((timeLeft % (24 * 60 * 60)) / (60 * 60))
        const minutes = Math.floor((timeLeft % (60 * 60)) / 60)
        const seconds = timeLeft % 60

        $('.promo_days').text(addLeadingZero(days))
        $('.promo_hours').text(addLeadingZero(hours))
        $('.promo_minutes').text(addLeadingZero(minutes))
        $('.promo_seconds').text(addLeadingZero(seconds))
      } else {
        $('.promo-bg').hide()
        $('#header_sticky').removeClass('header_sticky_promo')
        $('.top-wrap').removeClass('top-wrap-promo')
        $('.banner-top').removeClass('banner-top-promo')
        $('.burger-menu').removeClass('burger-menu-promo')
        clearInterval(timerInterval)
      }
    }

    const timerInterval = setInterval(updateCountdown, 1000)
    updateCountdown()

    $('.promo-code-placeholder').on('click', function () {
      const code = $(this).find('.promo-code-placeholder-text').text()

      const tempInput = $('<textarea>')
      tempInput.val(code)
      $('body').append(tempInput)
      tempInput.select()
      document.execCommand('copy')
      tempInput.remove()

      $('.promo-code-placeholder-text').text('Copied')
      $('.promo-code-placeholder-icon-copy').hide()
      $('.promo-code-placeholder-icon-copied').css('display', 'flex')
      $(this).addClass('promo-code-placeholder-copied')
    })

    $('.promo-close').on('click', function () {
      $('.promo-bg').hide()
      $('#header_sticky').removeClass('header_sticky_promo')
      $('.top-wrap').removeClass('top-wrap-promo')
      $('.banner-top').removeClass('banner-top-promo')
      $('.burger-menu').removeClass('burger-menu-promo')
    })
    /* promo script */

    // window.addEventListener('scroll', setStickyHeader)
    $(document.body).on('touchmove', setStickyHeader)
    $(document.body).on('scroll', setStickyHeader)
    $(window).on('scroll', setStickyHeader) 
    function setStickyHeader() {
      if (window.innerWidth >= 575) {
        var header_main_height = $('#header_main').height()
        var header_top_height = $('#header_main').find('.top').height()
        if (window.pageYOffset >= header_top_height) {
          $('#header_sticky').css({display: 'flex'})
          if (window.pageYOffset >= header_main_height) {
            $('#header_sticky').css({background: 'rgba(0, 0, 0, 0.32)', backdropFilter: 'blur(32px)'})
            // $('#header_sticky').find('.logo img').attr('src', logo_black_url)
            $('#header_sticky').find('.menu__item').addClass('menu__item-sticky')
            // $('.menu__item-chevron-down').attr('src', chevron_black)
            // $('#header_sticky').find('.menu__item').css({color: '#000000'})
            // $('#header_sticky').find('.menu__item a').css({color: '#000000'})
            // $('#header_sticky').find('.menu__item-button').css({color: '#FFFFFF'})
            // $('#header_sticky').find('.menu__item-button a').css({color: '#FFFFFF'})
            /*$('.menu__item-button').on('mouseover', function() {
              $(this).css({color: '#000000'})
              $(this).find('a').css({color: '#000000'})
            })
            $('.menu__item-button').on('mouseleave', function() {
              $(this).css({color: '#FFFFFF'})
              $(this).find('a').css({color: '#FFFFFF'})
            })*/
          }
          else {
            $('#header_sticky').css({background: 'transparent', backdropFilter: 'unset'})
            $('#header_sticky').find('.logo img').attr('src', logo_white_url)
            $('#header_sticky').find('.menu__item').removeClass('menu__item-sticky')
            $('.menu__item-chevron-down').attr('src', chevron_white)
            // $('#header_sticky').find('.menu__item').css({color: '#FFFFFF'})
            // $('#header_sticky').find('.menu__item a').css({color: '#FFFFFF'})
          }
        }
        else {      
          $('#header_sticky').css({display: 'none'})
        }
      }
      else {
        var top_link_height = $('.top-link').height()
        if ($('body').scrollTop() >= top_link_height) {
          $('.top-wrap').addClass('top-wrap-passed')
        }
        else {
          $('.top-wrap').removeClass('top-wrap-passed')
        }
        if ($('body').scrollTop() >= window.innerHeight) {
          $('.top-wrap').addClass('top-wrap-scrolled')
        }
        else {
          $('.top-wrap').removeClass('top-wrap-scrolled')
        }
      }
    }

    $('.button-menu').on('click', function() {
      $('.burger-menu-wrap').css('display', 'flex')
      $('.button-close').show()
      $(this).hide()
      $(this).parents('.top').removeClass('top-menu-closed').addClass('top-menu-opened')
      $(this).parents('.top').find('.logo-white').hide()
      $(this).parents('.top').find('.logo-black').show()
      $(this).parents('.top').find('.cart-white').hide()
      $(this).parents('.top').find('.cart-black').show()
      $(this).parents('#header_mobile').find('.banner').removeClass('banner-menu-closed').addClass('banner-menu-opened')
    })
    $('.button-close').on('click', function() {
      $('.burger-menu-wrap').hide()
      $('.button-menu').show()
      $(this).hide()
      $(this).parents('.top').removeClass('top-menu-opened').addClass('top-menu-closed')
      $(this).parents('.top').find('.logo-black').hide()
      $(this).parents('.top').find('.logo-white').show()
      $(this).parents('.top').find('.cart-black').hide()
      $(this).parents('.top').find('.cart-white').show()
      $(this).parents('#header_mobile').find('.banner').removeClass('banner-menu-opened').addClass('banner-menu-closed')
    })

    $(document).on('click', 'a[href^="#"]', function (e) {
      /*$('.burger-menu-wrap').hide()
      $('.button-close').hide()
      if ($(this).attr('href') == '#') {
        e.preventDefault()
      }*/
      if ($(this).attr('href') != '#') {
        e.preventDefault()
        $('.burger-menu-wrap').hide()
        $('.button-close').hide()
        $('html, body').animate({
            scrollTop: $($(this).attr('href')).offset().top
        }, 500)
      }
    })
    if (window.innerWidth >= 575) {
      $('.menu__item').on('mouseover', function() {
        let dropdown = $(this).find('.menu__item-dropdown')
        let chevron_down = $(this).find('.menu__item-chevron-down')
        let chevron_up = $(this).find('.menu__item-chevron-up')
          $('.menu__item-dropdown').each(function() {
            $(this).css('display', 'none')
            $(this).parent('.menu__item').removeClass('menu__item-opened')
          })
          $(dropdown).css('display', 'flex')
          $(chevron_down).hide()
          $(chevron_up).show()
          $(this).addClass('menu__item-opened')
      })
      $('.menu__item').on('mouseleave', function() {
        let dropdown = $(this).find('.menu__item-dropdown')
        let chevron_down = $(this).find('.menu__item-chevron-down')
        let chevron_up = $(this).find('.menu__item-chevron-up')
          $(dropdown).css('display', 'none')
          $(chevron_down).show()
          $(chevron_up).hide()
          $(this).removeClass('menu__item-opened')
      })
      $('.menu__item > a').on('click', function(e) {
        if (!$(this).parent('.menu__item').hasClass('menu__item-cart')) {
          e.preventDefault()
        }
      })
    }
    else {
      $('.menu__item-title').on('click', function(e) {
        e.preventDefault()
        let dropdown = $(this).parent('.menu__item').find('.menu__item-dropdown')
        let chevron_down = $(this).parent('.menu__item').find('.menu__item-chevron-down')
        let chevron_up = $(this).parent('.menu__item').find('.menu__item-chevron-up')
        if ($(dropdown).is(':visible')) {
          $(dropdown).css('display', 'none')
          $(chevron_down).show()
          $(chevron_up).hide()
          $(this).removeClass('menu__item-opened')
        }
        else {
          $('.menu__item-dropdown').each(function() {
            $(this).css('display', 'none')
            $(this).parent('.menu__item').removeClass('menu__item-opened')
          })
          $(dropdown).css('display', 'flex')
          $(chevron_down).hide()
          $(chevron_up).show()
          $(this).addClass('menu__item-opened')
        }      
      })
    }
    $(document).click(function(event) { 
      var $target = $(event.target)
      if (!$target.closest('.menu__item-opened').length) {
        $('.menu__item-dropdown').each(function() {
          $(this).css('display', 'none')
          let chevron_down = $(this).find('.menu__item-chevron-down')
          let chevron_up = $(this).find('.menu__item-chevron-up')
          $(chevron_down).show()
          $(chevron_up).hide()
          $(this).parent('.menu__item').removeClass('menu__item-opened')
        })
      }        
    })
    /*$('.expand').on('click', function() {
      document.getElementById('using').scrollIntoView()
    })*/
  })  
</script>
