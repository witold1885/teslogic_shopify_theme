<link rel="stylesheet" href="{{ 'shortcuts.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'shortcuts-responsive.css' | asset_url }}" media="print" onload="this.media='all'">

<style type="text/css">
	.shortcuts-features {
		background: url({{ 'shortcuts_features_bg.png' | asset_url }});
		background-size: cover;
		background-position: center;
	}
</style>

<div class="shortcuts">
	<div class="shortcuts-wrap">
		<div class="shortcuts-title">
			<div class="shortcuts-title-text">Teslogic Shortcuts:</div>
			<div class="shortcuts-title-icon">
				<img src="{{ 'shortcuts-top-icon.svg' | asset_url }}">
			</div>	
		</div>
		<div class="shortcuts-subtitle">
			Maximize your driving comfort with an innovative set of commands
		</div>
		<div class="shortcuts-info">
			<div class="shortcuts-info-block shortcuts-info-block-text">
				<div class="shortcuts-info-block-text-primary">"Teslogic Shortcuts" is a set of convenient commands that enable you to manage auxiliary vehicle systems not found in Tesla's basic functionality.</div>
				<div class="shortcuts-info-block-text-secondary">These commands add convenience without affecting the driving process or compromising vehicle safety</div>
			</div>
			<div class="shortcuts-info-block shortcuts-info-block-car shortcuts-info-block-relative">
				<div class="shortcuts-info-block-background">
					<img class="shortcuts-info-block-background-desktop" src="{{ 'shortcuts-car-bg-desktop.png' | asset_url }}" srcset="{{ 'shortcuts-car-bg-retina.png' | asset_url }} 2x" loading="lazy">
					<img class="shortcuts-info-block-background-mobile" src="{{ 'shortcuts-car-bg-mobile.png' | asset_url }}" srcset="{{ 'shortcuts-car-bg-mobile-retina.png' | asset_url }} 2x" loading="lazy">
				</div>
				<div class="shortcuts-info-block-image">
					<img class="shortcuts-info-block-image-desktop" src="{{ 'shortcuts-iphone-desktop.png' | asset_url }}" srcset="{{ 'shortcuts-iphone-retina.png' | asset_url }} 2x" loading="lazy">
					<img class="shortcuts-info-block-image-mobile" src="{{ 'shortcuts-iphone-mobile.png' | asset_url }}" srcset="{{ 'shortcuts-iphone-mobile-retina.png' | asset_url }} 2x" loading="lazy">
				</div>
			</div>
			<div class="shortcuts-info-block shortcuts-info-block-artboard shortcuts-info-block-between">
				<div class="shortcuts-info-block-between-image shortcuts-info-artboard-image">
					<img class="shortcuts-info-artboard-image-desktop" src="{{ 'shortcuts-artboard-desktop.png' | asset_url }}" srcset="{{ 'shortcuts-artboard-retina.png' | asset_url }} 2x" loading="lazy">
					<img class="shortcuts-info-artboard-image-mobile" src="{{ 'shortcuts-artboard-mobile.png' | asset_url }}" srcset="{{ 'shortcuts-artboard-mobile-retina.png' | asset_url }} 2x" loading="lazy">
				</div>
				<div class="shortcuts-info-block-between-text shortcuts-info-artboard-text">
					To activate Shortcuts, you need to switch the Active Control toggle to the "on" position using a pin or any other object.
				</div>
			</div>
			<div class="shortcuts-info-block shortcuts-info-block-info shortcuts-info-block-between">
				<div class="shortcuts-info-block-between-image shortcuts-info-info-image">
					<img class="shortcuts-info-info-image-desktop" src="{{ 'shortcuts-info-icon.svg' | asset_url }}">
					<img class="shortcuts-info-info-image-mobile" src="{{ 'shortcuts-info-icon-mobile.svg' | asset_url }}">
				</div>
				<div class="shortcuts-info-block-between-text shortcuts-info-info-text">
					Shortcuts settings and changes are stored within the transmitter, enabling them to function when the phone is disconnected.
				</div>				
			</div>
		</div>
        {% assign blocks = "performance-driv-ing-modes,safety-stability-features,convenien-ce-comfort,autopilot-tweaks-beta" | split: ',' %}
		<div class="shortcuts-features">
			{% for block in blocks %}
				{% assign items = blogs[block].articles | sort: 'title' %}
				<div class="shortcuts-features-block shortcuts-features-block-{{ forloop.index }}">
					<div class="shortcuts-features-block-title">{{ blogs[block].title }}</div>
					<div class="shortcuts-features-block-items">
						{% for item in items %}
							{% assign title_array = item.title | split: ' ' %}
							{% assign number = title_array.first %}
							{% assign title = item.title | replace: number, '' %}
							<div class="shortcuts-features-block-item shortcuts-features-block-item-{{ forloop.index }}">
								<div class="shortcuts-features-block-item-top">
									<div class="shortcuts-features-block-item-title">{{ title }}</div>
									<div class="shortcuts-features-block-item-icon">
										<img src="{{ item.image }}" alt="">
									</div>
								</div>
								<div class="shortcuts-features-block-item-content">{{ item.content }}</div>
							</div>
						{% endfor %}
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
</div>

<script type="text/javascript">
  $(document).ready(function() {
	  var content = document.querySelector('.shortcuts-features-scroller');
		var scrollbar = document.querySelector('.shortcuts-features-scrollbar');
	  var scrollbarThumb = document.querySelector('.shortcuts-features-scrollbar-thumb');

		scrollbar.addEventListener('mousedown', function (event) {
		  var offsetX = event.clientX - scrollbar.getBoundingClientRect().left;
		  var scrollLeftPercentage = (offsetX / scrollbar.clientWidth) * 100;
		  content.scrollLeft = (content.scrollWidth - content.clientWidth) * (scrollLeftPercentage / 100);
		  updateScrollbarThumbPosition();
		});

		scrollbarThumb.addEventListener('mousedown', function (event) {
		  var startX = event.clientX;
		  var startThumbLeft = scrollbarThumb.offsetLeft;

		  function handleMouseMove(event) {
		    var deltaX = event.clientX - startX;
		    var newThumbLeft = startThumbLeft + deltaX;

		    newThumbLeft = Math.max(0, Math.min(newThumbLeft, scrollbar.clientWidth));

		    var newThumbLeftPercentage = (newThumbLeft / scrollbar.clientWidth) * 100;

		    scrollbarThumb.style.left = `calc(${newThumbLeftPercentage}% - ${56 * newThumbLeftPercentage / 100}px)`;
		    content.scrollLeft = (content.scrollWidth - content.clientWidth) * (newThumbLeftPercentage / 100);
		  }

		  function handleMouseUp() {
		    document.removeEventListener('mousemove', handleMouseMove);
		    document.removeEventListener('mouseup', handleMouseUp);
		  }

		  document.addEventListener('mousemove', handleMouseMove);
		  document.addEventListener('mouseup', handleMouseUp);
		});

	  content.addEventListener('scroll', function () {
	  	updateScrollbarThumbPosition()
	  });

		function updateScrollbarThumbPosition() {
		  let scrollLeftPercentage = (content.scrollLeft / (content.scrollWidth - content.clientWidth)) * 100;
		  scrollbarThumb.style.left = `calc(${scrollLeftPercentage}% - ${56 * scrollLeftPercentage / 100}px)`;
		}

		const slider = document.querySelector('.shortcuts-features-scroller');
		let isDown = false;
		let startX;
		let scrollLeft;

		slider.addEventListener('mousedown', (e) => {
		  isDown = true;
		  slider.classList.add('active');
		  startX = e.pageX - slider.offsetLeft;
		  scrollLeft = slider.scrollLeft;
		});
		slider.addEventListener('mouseleave', () => {
		  isDown = false;
		  slider.classList.remove('active');
		});
		slider.addEventListener('mouseup', () => {
		  isDown = false;
		  slider.classList.remove('active');
		});
		slider.addEventListener('mousemove', (e) => {
		  if(!isDown) return;
		  e.preventDefault();
		  const x = e.pageX - slider.offsetLeft;
		  const walk = (x - startX) * 1; //scroll-fast
		  slider.scrollLeft = scrollLeft - walk;
		  // console.log(walk);
		});

		$('.shortcuts-features-item-title').on('click', function() {
			let block = $(this).parents('.shortcuts-features-item-mobile')
			let show = $(block).data('show')
			if (show == 'image') {
				$(block).find('.shortcuts-features-item-image').hide()
				$(block).find('.shortcuts-features-item-description').show()
				$(this).find('.shortcuts-features-item-title-chevron-down').hide()
				$(this).find('.shortcuts-features-item-title-chevron-up').show()
				$(this).find('.shortcuts-features-item-title-icon-blue').hide()
				$(this).find('.shortcuts-features-item-title-icon-black').show()
				$('.shortcuts-features-item-speedicons').hide()
				$(block).data('show', 'description')
				return
			}
			if (show == 'description') {
				$(block).find('.shortcuts-features-item-description').hide()
				$(block).find('.shortcuts-features-item-image').show()
				$(this).find('.shortcuts-features-item-title-chevron-up').hide()
				$(this).find('.shortcuts-features-item-title-chevron-down').show()
				$(this).find('.shortcuts-features-item-title-icon-black').hide()
				$(this).find('.shortcuts-features-item-title-icon-blue').show()
				$('.shortcuts-features-item-speedicons').show()
				$(block).data('show', 'image')
				return
			}
		}) 
  })
</script>
