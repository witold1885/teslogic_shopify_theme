<style type="text/css">
    .screenmate-dashboard {
        background: linear-gradient(180deg, #FBFBFB 0%, #EFF3FB 100%);
        margin: 0 auto;
        padding: 180px 0 180px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .screenmate-dashboard-wrap {
        width: 1076px;
        display: flex;
        flex-direction: column;
    }
    .screenmate-dashboard-collage {
        width: 100%;
        height: 641px;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 117px;
    }
    .screenmate-dashboard-collage > div {
        position: absolute;
    }
    .screenmate-dashboard-collage-background {
        width: 100%;
        height: 577px;
        bottom: 0;
        z-index: 1;
        border-radius: 64px 64px 40px 40px;
        background: url({{ 'screenmate_dashboard_background.png' | asset_url }}) no-repeat;
        background-size: cover;
        background-position: center;
    }
    .screenmate-dashboard-collage-main {
        width: 1028px;
        height: 617px;
        top: 0;
        z-index: 2;
        display: flex;
        justify-content: space-between;
    }
    .screenmate-dashboard-collage-main > div {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 502px;
        padding: 20px 24px 24px;
        border-radius: 40px;
        border: 2px solid #FFF;
        background: linear-gradient(180deg, #F7F7F7 0%, #FFF 100%);
        box-shadow: 0px 0px 40px 0px rgba(0, 0, 0, 0.08);
        box-sizing: border-box;
    }
    .screenmate-dashboard-collage-main-info {
        display: flex;
        flex-direction: column;
        row-gap: 16px;
    }
    .screenmate-dashboard-collage-main-info-title {
        color: #000;
        font-family: Manrope;
        font-size: 52px;
        font-style: normal;
        font-weight: 500;
        line-height: 64px;
    }
    .screenmate-dashboard-collage-main-info-text {
        color: #666;
        font-family: Manrope;
        font-size: 18px;
        font-style: normal;
        font-weight: 400;
        line-height: 24px;
    }
    .screenmate-dashboard-collage-main-image {
        width: 454px;
        height: 341px;
    }
    .screenmate-dashboard-collage-main-image img {
        width: 100%;
    }
    .screenmate-dashboard-controls, .screenmate-dashboard-commands {
        margin-bottom: 136px;
    }
    .screenmate-dashboard-controls-title, .screenmate-dashboard-commands-title {
        color: var(--Black, #0F0F0F);
        font-family: Manrope;
        font-size: 52px;
        font-style: normal;
        font-weight: 500;
        line-height: 64px;
        margin-bottom: 16px;
    }
    .screenmate-dashboard-controls-text, .screenmate-dashboard-commands-text {
        color: #666;
        font-family: Manrope;
        font-size: 18px;
        font-style: normal;
        font-weight: 400;
        line-height: 24px;
        margin-bottom: 32px;
    }
    .screenmate-dashboard-controls-items {
        display: flex;
        align-items: center;
        column-gap: 24px;
    }
    .screenmate-dashboard-controls-item {
        width: 159px;
        height: 160px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        row-gap: 12px;
        border-radius: 40px;
        background: linear-gradient(0deg, #FFF 0%, #FFF 100%), linear-gradient(180deg, #222 0%, #090909 100%);
        box-shadow: 0px 4px 32px 0px rgba(0, 0, 0, 0.08);
    }
    .screenmate-dashboard-controls-item img {
        width: 48px;
        height: 48px;
    }
    .screenmate-dashboard-controls-item-text {
        color: #3D3D3D;
        text-align: center;
        font-family: "Universal Sans Display";
        font-size: 14px;
        font-style: normal;
        font-weight: 500;
        line-height: 20px;
        letter-spacing: 0.252px;
        text-transform: capitalize;
    }
    .screenmate-dashboard-commands-items {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
    }
    .screenmate-dashboard-commands-item {
        width: 251px;
        padding: 16px 12px 16px 16px;
        display: flex;
        align-items: center;
        column-gap: 10px;
        border-radius: 16px;
        background: #FFF;
        box-shadow: 0px 4px 32px 0px rgba(0, 0, 0, 0.08);
        box-sizing: border-box;
    }
    .screenmate-dashboard-commands-item img {
        width: 32px;
        height: 32px;
    }
    .screenmate-dashboard-commands-item-text {
        color: #3B3B3B;
        font-family: "SF Pro Display";
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 20px;
    }
    .screenmate-dashboard-native {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 98px;
    }
    .screenmate-dashboard-native-info {
        display: flex;
        flex-direction: column;
        row-gap: 24px;
    }
    .screenmate-dashboard-native-info-title {
        color: var(--Black, #0F0F0F);
        font-family: Manrope;
        font-size: 52px;
        font-style: normal;
        font-weight: 500;
        line-height: 64px;
    }
    .screenmate-dashboard-native-info-content {
        display: flex;
        flex-direction: column;
        row-gap: 18px;
    }
    .screenmate-dashboard-native-info-content > div {
        color: #666;
        font-family: Manrope;
        font-size: 18px;
        font-style: normal;
        font-weight: 400;
        line-height: 24px;
    }
    .screenmate-dashboard-native-info-content > div a {
        color: #0465FD;
        font-weight: 500;
        text-decoration: none;
    }
    .screenmate-dashboard-native-collage {
        width: 416px;
        height: 300px;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .screenmate-dashboard-native-collage > div {
        position: absolute;
    }
    .screenmate-dashboard-native-collage-background {
        width: 100%;
        height: 252px;
        bottom: 0;
        z-index: 1;
        border-radius: 32px 32px 56px 56px;
        background: url({{ 'screenmate_dashboard_native_background.png' | asset_url }}) no-repeat;
        box-shadow: 0px 4px 48px 0px rgba(0, 0, 0, 0.10);
        background-size: cover;
        background-position: center;
    }
    .screenmate-dashboard-native-collage-image {
        width: 368px;
        height: 276px;
        top: 0;
        z-index: 2;
        border-radius: 40px;
        background: url({{ 'screenmate_dashboard_native_image.png' | asset_url }}) lightgray -532.503px -288px / 272.182% 204.348% no-repeat;
        box-shadow: 0px 4px 20px 0px rgba(0, 0, 0, 0.30);
        background-size: cover;
        background-position: center;
    }
</style>

{% assign controls = blogs['screenmate-controls'].articles | sort: 'title' %}
{% assign commands = blogs['screenmate-commands'].articles | sort: 'title' %}

<div class="screenmate-dashboard">
    <div class="screenmate-dashboard-wrap">
        <div class="screenmate-dashboard-collage">
            <div class="screenmate-dashboard-collage-background"></div>
            <div class="screenmate-dashboard-collage-main">
                <div class="screenmate-dashboard-collage-main-left">
                    <div class="screenmate-dashboard-collage-main-info">
                        <div class="screenmate-dashboard-collage-main-info-title">Dashboard</div>
                        <div class="screenmate-dashboard-collage-main-info-text">
                            Keep your instrument panel with all vital car <br>
                            information in view on top of your apps. Track <br>
                            current speed, speed limit, blindspots warnings, <br>
                            battery charge, and more. You can also easily <br>
                            minimize or move it aside for a clearer view. 
                        </div>                    
                    </div>
                    <div class="screenmate-dashboard-collage-main-image">
                        <img src="{{ 'screenmate_dashboard_image_1.png' | asset_url }}" alt="">
                    </div>
                </div>
                <div class="screenmate-dashboard-collage-main-right">
                    <div class="screenmate-dashboard-collage-main-info">
                        <div class="screenmate-dashboard-collage-main-info-title">Control Panel</div>
                        <div class="screenmate-dashboard-collage-main-info-text">
                            Access all essential commands with just one touch. <br>
                            A compact Control Panel offers a wide range of <br>
                            functions, making it easy to dim mirrors or adjust <br>
                            the passenger seat—everything you need is just a <br>
                            tap away.
                        </div>                    
                    </div>
                    <div class="screenmate-dashboard-collage-main-image">
                        <img src="{{ 'screenmate_dashboard_image_2.png' | asset_url }}" alt="">
                    </div>
                </div>
            </div>
        </div>
        <div class="screenmate-dashboard-controls">
            <div class="screenmate-dashboard-controls-title">
                Controls That Tesla Doesn’t Have
            </div>
            <div class="screenmate-dashboard-controls-text">
                We’ve added extra control functions for you, like activating battery heating <br>
                for faster charging, opening any door or charge port with a single click.
            </div>
            <div class="screenmate-dashboard-controls-items">
		        {% for control in controls %}
                    {% assign title_array = control.title | split: ' ' %}
                    {% assign number = title_array.first %}
                    {% assign title = control.title | replace: number, '' %}
                    {% assign title_parts = title | split: ' ' %}
                    <div class="screenmate-dashboard-controls-item screenmate-dashboard-controls-item-{{ number }}">
                        <img src="{{ control.image | img_url }}" alt="{{ title }}">
                        <div class="screenmate-dashboard-controls-item-text">
                            {% if title_parts.size == 2 %}
                                {{ title_parts[0] }}<br>{{ title_parts[1] }}
                            {% elsif title_parts.size == 3 %}
                                {{ title_parts[0] }} {{ title_parts[1] }}<br>{{ title_parts[2] }}
                            {% elsif title_parts.size == 4 %}
                                {{ title_parts[0] }} {{ title_parts[1] }}<br>{{ title_parts[2] }} {{ title_parts[3] }}
                            {% else %}
                                {{ title }}
                            {% endif %}
                        </div>
                    </div>
	    	    {% endfor %}
            </div>
        </div>
        <div class="screenmate-dashboard-commands">
            <div class="screenmate-dashboard-commands-title">
                Advanced Screenmate Commands
            </div>
            <div class="screenmate-dashboard-commands-text">
                We also plan to offer a software environment where you can create your own smart <br>
                functions and automation scripts in Python. Here you can find examples of these scripts.
            </div>
            <div class="screenmate-dashboard-commands-items">
		        {% for command in commands %}
                    {% assign title_array = command.title | split: ' ' %}
                    {% assign number = title_array.first %}
                    {% assign title = command.title | replace: number, '' %}
                    <div class="screenmate-dashboard-commands-item screenmate-dashboard-commands-item-{{ number }}">
                        <img src="{{ command.image | img_url }}" alt="{{ title }}">
                        <div class="screenmate-dashboard-commands-item-text">{{ title }}</div>
                    </div>
	    	    {% endfor %}
            </div>
        </div>
        <div class="screenmate-dashboard-native">
            <div class="screenmate-dashboard-native-info">
                <div class="screenmate-dashboard-native-info-title">
                    Teslogic v2 Dashboard <br>Native Support
                </div>
                <div class="screenmate-dashboard-native-info-content">
                    <div>
                        Teslogic v2 transforms your phone into a fully functional instrument <br>
                        cluster, conveniently positioned right in your line of sight.
                    </div>
                    <div>
                        The app features five customizable screens, allowing you to switch <br>
                        between them effortlessly using the selector on your steering wheel. 
                    </div>
                    <div>
                        For details about the product, visit <a href="/">v2 page</a>.
                    </div>
                </div>            
            </div>
            <div class="screenmate-dashboard-native-collage">
                <div class="screenmate-dashboard-native-collage-background"></div>
                <div class="screenmate-dashboard-native-collage-image"></div>
            </div>
        </div>
        <div class="screenmate-dashboard-addons">
        </div>
    </div>
</div>
