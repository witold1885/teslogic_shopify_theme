<div class="screenmate-dashboard">
    <div class="screenmate-dashboard-wrap">
        <div class="screenmate-dashboard-collage">
            <div class="screenmate-dashboard-collage-background"></div>
            <div class="screenmate-dashboard-collage-main">
                <div class="screenmate-dashboard-collage-main-left">
                    <div class="screenmate-dashboard-collage-main-info">
                        <div class="screenmate-dashboard-collage-main-info-title">Dashboard</div>
                        <div class="screenmate-dashboard-collage-main-info-text">
                            Keep your instrument panel with all vital car <br>
                            information in view on top of your apps. Track <br>
                            current speed, speed limit, blindspots warnings, <br>
                            battery charge, and more. You can also easily <br>
                            minimize or move it aside for a clearer view. 
                        </div>                    
                    </div>
                    <div class="screenmate-dashboard-collage-main-image">
                        <img src="{{ 'screenmate_dashboard_image_1.gif' | asset_url }}" alt="">
                    </div>
                </div>
                <div class="screenmate-dashboard-collage-main-right">
                    <div class="screenmate-dashboard-collage-main-info">
                        <div class="screenmate-dashboard-collage-main-info-title">Control Panel</div>
                        <div class="screenmate-dashboard-collage-main-info-text">
                            Access all essential commands with just one touch. <br>
                            A compact Control Panel offers a wide range of <br>
                            functions, making it easy to dim mirrors or adjust <br>
                            the passenger seat—everything you need is just a <br>
                            tap away.
                        </div>                    
                    </div>
                    <div class="screenmate-dashboard-collage-main-image">
                        <img src="{{ 'screenmate_dashboard_image_2.gif' | asset_url }}" alt="">
                    </div>
                </div>
            </div>
        </div>
        <div class="screenmate-dashboard-controls">
            <div class="screenmate-dashboard-controls-title">
                Controls That Tesla Doesn’t Have
            </div>
            <div class="screenmate-dashboard-controls-text">
                We’ve added extra control functions for you, like activating battery heating <br>
                for faster charging, opening any door or charge port with a single click.
            </div>
            <div class="screenmate-dashboard-controls-items">
		        {% for control in controls %}
                    {% assign title_array = control.title | split: ' ' %}
                    {% assign number = title_array.first %}
                    {% assign title = control.title | replace: number, '' %}
                    {% assign title_parts = title | split: ' ' %}
                    <div class="screenmate-dashboard-controls-item screenmate-dashboard-controls-item-{{ number }}">
                        <img src="{{ control.image | img_url }}" alt="{{ title }}">
                        <div class="screenmate-dashboard-controls-item-text">
                            {% if title_parts.size == 2 %}
                                {{ title_parts[0] }}<br>{{ title_parts[1] }}
                            {% elsif title_parts.size == 3 %}
                                {{ title_parts[0] }} {{ title_parts[1] }}<br>{{ title_parts[2] }}
                            {% elsif title_parts.size == 4 %}
                                {{ title_parts[0] }} {{ title_parts[1] }}<br>{{ title_parts[2] }} {{ title_parts[3] }}
                            {% else %}
                                {{ title }}
                            {% endif %}
                        </div>
                    </div>
	    	    {% endfor %}
            </div>
        </div>
        <div class="screenmate-dashboard-commands">
            <div class="screenmate-dashboard-commands-title">
                Advanced Screenmate Commands
            </div>
            <div class="screenmate-dashboard-commands-text">
                We also plan to offer a software environment where you can create your own smart <br>
                functions and automation scripts in Python. Here you can find examples of these scripts.
            </div>
            <div class="screenmate-dashboard-commands-items">
		        {% for command in commands %}
                    {% assign title_array = command.title | split: ' ' %}
                    {% assign number = title_array.first %}
                    {% assign title = command.title | replace: number, '' %}
                    <div class="screenmate-dashboard-commands-item screenmate-dashboard-commands-item-{{ number }}">
                        <img src="{{ command.image | img_url }}" alt="{{ title }}">
                        <div class="screenmate-dashboard-commands-item-text">{{ title }}</div>
                    </div>
	    	    {% endfor %}
            </div>
        </div>
        <div class="screenmate-dashboard-native">
            <div class="screenmate-dashboard-native-info">
                <div class="screenmate-dashboard-native-info-title">
                    Teslogic v2 Dashboard <br>Native Support
                </div>
                <div class="screenmate-dashboard-native-info-content">
                    <div>
                        Teslogic v2 transforms your phone into a fully functional instrument <br>
                        cluster, conveniently positioned right in your line of sight.
                    </div>
                    <div>
                        The app features five customizable screens, allowing you to switch <br>
                        between them effortlessly using the selector on your steering wheel. 
                    </div>
                    <div>
                        For details about the product, visit <a href="/">v2 page</a>.
                    </div>
                </div>            
            </div>
            <div class="screenmate-dashboard-native-collage">
                <div class="screenmate-dashboard-native-collage-background"></div>
                <div class="screenmate-dashboard-native-collage-image"></div>
            </div>
        </div>
        <div class="screenmate-dashboard-addons">
            <div class="screenmate-dashboard-addons-title">Add-ons</div>
            <div class="screenmate-dashboard-addons-items">
		        {% for addon in addons %}
                    {% assign title_array = addon.title | split: ' ' %}
                    {% assign number = title_array.first %}
                    {% assign title = addon.title | replace: number, '' %}
                    {% assign title_parts = title | split: ' ' %}
                    <div class="screenmate-dashboard-addons-item screenmate-dashboard-addons-item-{{ number }}">
                        <div class="screenmate-dashboard-addons-item-title">
                            {% if number == '03' %}
                                {{ title_parts[0] }}<br>{{ title_parts[1] }}{{ title_parts[2] }}
                            {% else %}
                                {{ title }}
                            {% endif %}
                        </div>
                        <div class="screenmate-dashboard-addons-item-image">
                            <img src="{{ addon.image | img_url }}" alt="{{ title }}">
                        </div>
                        <div class="screenmate-dashboard-addons-item-text">{{ addon.content }}</div>
                    </div>
	    	    {% endfor %}
            </div>
        </div>
    </div>
</div>
