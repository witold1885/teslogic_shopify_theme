		<div class="reviews-pagination"></div>
		<div class="reviews-bottom">
			<div class="reviews-bottom-text">
				Already own Screenmate Dash?
			</div>
			<button id="showForm">Write a review</button>
		</div>
	</div>
</div>

<div class="reviews-form-shadow">
	<div id="reviewsFormWrap" class="reviews-form-wrap">
		<img class="reviews-form-close" src="{{ 'close-review-form.svg' | asset_url }}">
		<form class="reviews-form">
			
		</form>
	</div>
</div>

<div id="reviews-popup" class="subscription-popup-shadow">
	<div class="success-popup">
		<div class="success-popup-close">
			<img src="{{ 'subscription_popup_close.svg' | asset_url }}" alt="">
		</div>
		<div class="subscription-popup-logo">
			<img src="{{ 'subscription_popup_logo.svg' | asset_url }}" alt="">
		</div>
