{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{{ 'section-contact-form-responsive.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="contact">
  {%- form 'contact', id: 'ContactForm', class: 'isolate' -%}
    <div class="contact__wrap">
      <div class="contact__info">
        <div class="contact__info-top">
          <h2 class="contact__title">Contact us</h2>
          <div class="contact__info-notes">
            <div>
              Our <a href="/faq">FAQ</a> section provides answers to all frequently asked questions. If your inquiry is not listed there, please don't hesitate to contact our Support team.
            </div>
            <div>
              We will also be glad to receive your feedback and any ideas.
            </div>
          </div>
        </div>
        <div class="contact__info-item">
          <div class="contact__info-item-title">Email</div>
          <div class="contact__info-item-text">
            <a href="mailto:info@screenmate.co">info@screenmate.co</a>
          </div>
        </div>
        <div class="contact__info-item">
          <div class="contact__info-item-title">Address</div>
          <div class="contact__info-item-text">
            Meydan Grandstand, 6th Floor<br>
            Meydan Road, Nad Al Sheba<br>
            Dubai, U.A.E.
          </div>
        </div>
      </div>
      {% assign form_classes = 'contact__form' %}
      {%- if form.posted_successfully? -%}
        {% assign form_classes = form_classes | append: ' contact__form-success' %}
      {% endif %}
      <div class="{{ form_classes }}">
        {%- if form.posted_successfully? -%}
          <div class="contact__success">
            Thanks for contacting us.<br>
            We will get back to you as soon as possible!
          </div>
        {%- else -%}
          <div class="contact__fields">
            <div class="contact__field" data-param="email">
              <label class="contact__field-label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
              <input class="contact__field-input" autocomplete="name" type="text" id="ContactForm-name" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Enter your name">
            </div>
            <div class="contact__field field--with-error" data-param="name">
              <label class="contact__field-label" for="ContactForm-email">{{ 'templates.contact.form.email' | t }}</label>
              <input
                autocomplete="email"
                type="email"
                id="ContactForm-email"
                class="contact__field-input"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ContactForm-email-error"
                {% endif %}
                placeholder="johnsmith@mail.com"
              >
              {%- if form.errors contains 'email' -%}
                <small class="contact__field-error" id="ContactForm-email-error">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  <span class="form__message">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</span>
                </small>
              {%- endif -%}
            </div>
            <div class="contact__field" data-param="phone">
              <label class="contact__field-label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
              <input type="tel" id="ContactForm-phone" class="contact__field-input" autocomplete="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" pattern="+[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="+1">
            </div>
            <div class="contact__field" data-param="comment">
              <label class="contact__field-label" for="ContactForm-body">{{ 'templates.contact.form.comment' | t }}</label>
              <textarea
                rows="10"
                id="ContactForm-body"
                class="contact__field-input contact__field-textarea"
                name="contact[{{ 'templates.contact.form.comment' | t }}]"
                placeholder="{{ 'templates.contact.form.comment' | t }}"
              >
                {{- form.body -}}
              </textarea>
            </div>
          </div>
          <button type="button" class="contact__button">
            {{ 'templates.contact.form.send' | t }}
          </button>
        {%- endif -%}
      </div>
    </div>
  {%- endform -%}
</div>

<script type="text/javascript">
  $(document).ready(function() {
    const form = $('#ContactForm')

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

    $('.contact__button').on('click', function() {
      let isValid = true

      $('.contact__field').each(function() {
        const param = $(this).data('param')
        const field = $(this).find('input') || $(this).find('textarea')
        const value = field.val()
        let error = null

        if (!value) {
          error = 'Fill in the field'
        } else if (param === 'email' && !emailRegex.test(value)) {
          error = 'Email not valid'
        }

        if (error) {
          field.prop('aria-invalid', true)
          field.append(`
            <small class="contact__field-error" id="ContactForm-${param}-error">
              <span class="form__message">${error}</span>
            </small>
          `)
          isValid = false
        }
      })

      if (isValid) {
        form.submit()
      }
    })
  })
</script>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Contact us",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.all.colors.accent_2.label"
        },
        {
          "value": "background-1",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "background-2",
          "label": "t:sections.all.colors.background_2.label"
        },
        {
          "value": "inverse",
          "label": "t:sections.all.colors.inverse.label"
        }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
