<script type="text/javascript">
	$(document).ready(async function () {
		const currencyCode = '{{ currency_code }}'
		const countryCode = '{{ localization.country.iso_code }}'
		const euTaxes = {{ eu_taxes }}

		const response = await fetch('https://api.teslogic.co/api/rate/USD/EUR')
		const data = await response.json()
		const coef = currencyCode === 'EUR' ? (data.rate || 1) : 1

		const setPrice = (usdPrice, num, type = 'new') => {
			const price = usdPrice * coef
			const priceText = `${price.toFixed(0)} ${currencyCode}`
			let vatText = ''

			if (currencyCode === 'EUR') {
				const tax = euTaxes[countryCode] || 20
				const vat = price * tax / 100
				if (type === 'new' || type === 'add') {
					vatText = `+${vat.toFixed(0)} EUR (VAT ${tax}%)`
					if (type === 'new') vatText = `<br><div class="order-product-data-info-price-vat">${vatText}</div>`
				}
			}

			let selector = `.order-product-${num} .order-product-data-info-price-main`
			if (type === 'add') selector = `.order-product-${num} .order-product-data-add-price`
			
			$(selector).empty().html(`${priceText} ${vatText}`)
		}

		Object.entries({
			"1": {{ product1.price | divided_by: 100 }},
			"2": {{ product2.price | divided_by: 100 }}
		}).forEach(([num, price]) => {
			setPrice(price, num)
			setPrice({{ charger.price | divided_by: 100 }}, num, 'add')
		})

		var num
		$('.order-product-data-preorder-button.preorder-performance').on('click', function () {
			num = $(this).data('num')
			$('.order-dialog-shadow').css('display', 'flex')
		})

		$('.order-dialog-close').on('click', function () {
			$('.order-dialog-shadow').css('display', 'none')
		})

		$('.order-dialog-button-check').on('click', function () {
			$('.order-dialog-shadow').css('display', 'none')
			$('.compatibility-check-dialog-shadow').css('display', 'flex')
		})

		$('.order-dialog-button-preorder, .preorder-boost').on('click', function () {
			if ($(this).data('num')) num = $(this).data('num')
			let product_id = $(`#product-${num}-variant-id`).val()
			let items = [{ id: Number(product_id), quantity: 1 }]
			if ($(`#select-charger-${num}`).prop('checked') === true) {
				let charger_variant_id = $('#charger-variant-id').val()
				items.push({ id: Number(charger_variant_id), quantity: 1 })
			}
			let formData = { items }
			fetch(window.Shopify.routes.root + 'cart/add.js', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: JSON.stringify(formData)
			}).then(response => {
			  	window.location.href = '/cart'
			}).catch((error) => {
			  	console.error('Error:', error)
			})
		})
	})
</script>
