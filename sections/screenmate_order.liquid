<link rel="stylesheet" href="{{ 'store.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'store-responsive.css' | asset_url }}" media="print" onload="this.media='all'">

{% style %}	
    .store_block {
        padding-top: 180px;
        padding-bottom: 180px;
    }
    .store_block-product {
        width: 1076px;
    }
	.store_block-add-wireless-checkbox:checked:after {
		content: "";
		position: absolute;
		width: 12px;
		height: 10px; 
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		color: #000;
		background-image: url({{ 'ok.svg' | asset_url }});
		background-size: contain;
		background-repeat: no-repeat;
		background-position: center;
	}
	.store_block-product-preorder-delivery {
		margin-top: 16px;
		color: #000;
		font-feature-settings: 'liga' off, 'clig' off;
		font-family: Manrope;
		font-size: 16px;
		font-style: normal;
		font-weight: 400;
		line-height: 20px;
	}
	.store_block-product-preorder-delivery span {
		color: #1657FC;
	}
	@media screen and (min-width: 576px) and (max-width: 1440px) {
        .store_block {
            padding-top: calc(180 * 100vw / 1440);
            padding-bottom: calc(180 * 100vw / 1440);
        }
        .store_block-product {
            width: calc(1076 * 100vw / 1440);
        }
		.store_block-add-wireless-checkbox:checked:after {
			width: calc(12 * 100vw / 1440);
			height: calc(10 * 100vw / 1440);
		}
		.store_block-product-preorder-delivery {
			margin-top: calc(16 * 100vw / 1440);
			font-size: calc(16 * 100vw / 1440);
			line-height: calc(20 * 100vw / 1440);
		}
	}
	@media screen and (max-width: 575px) {
		.store_block {
			padding-top: calc(96 * 100vw / 375);
			padding-bottom: calc(100 * 100vw / 375);
		}
		.store_block-product {
			width: calc(375 * 100vw / 375);
		}
		.store_block-add-wireless-checkbox:checked:after {
			width: calc(12 * 100vw / 375);
			height: calc(10 * 100vw / 375);
		}
	}
{% endstyle %}

{% assign product = all_products['teslogic-screenmate'] %}
{% assign charger = all_products['screenmate-wireless-charger'] %}

<div class="store_block" id="shop-now">
	<div class="store_block-product">
		<div class="store_block-product-gallery">
			{% comment %} <div class="store_block-product-gallery-items">
				{% assign counter = 0 %}  
				{% for image in product.images %}
					<div class="store_block-product-gallery-item {% if counter == 0 %}active{% endif %}" data-imgnum="{{ counter }}">
						<img class="store_block-product-gallery-item-image" src="{{ image | img_url: '172x172' }}">
					</div>
					{% assign counter = counter | plus: 1 %}
				{% endfor %}
			</div> {% endcomment %}
			<div class="store_block-product-gallery-main">
				{% assign counter = 0 %}  
				{% for image in product.images %}
					<img data-imgnum="{{ counter }}" src="{{ image | img_url: '1052x1052' }}">
					{% assign counter = counter | plus: 1 %}
				{% endfor %}
			</div>
		</div>
		<div class="store_block-product-info">
			<div class="store_block-product-info-main">
				<div class="store_block-product-price">  
					<div class="store_block-product-price-new">{{ product.price | divided_by: 100 }} USD</div>
					<div class="store_block-product-price-old">{{ product.compare_at_price | divided_by: 100 }} USD</div>
				</div>
				<div class="store_block-product-title">{{ product.title }}</div>
			</div>
			<div class="store_block-product-gallery-mobile">
				{% comment %} <div class="store_block-product-gallery-mobile-nav" data-direction="prev"></div> {% endcomment %}
				<div class="store_block-product-gallery-main">
					{% assign counter = 0 %}  
					{% for image in product.images %}
						<img data-imgnum="{{ counter }}" src="{{ image | img_url: '1052x1052' }}">
						{% assign counter = counter | plus: 1 %}
					{% endfor %}
				</div>
				{% comment %} <div class="store_block-product-gallery-mobile-nav" data-direction="next"></div> {% endcomment %}
				{% comment %} <div class="store_block-product-gallery-mobile-dots">
					{% for i in (0..5) %}
						<div data-imgnum="{{ i }}" class="store_block-product-gallery-mobile-dot">
							<img class="store_block-product-gallery-mobile-dot-active" src="{{ 'store-gallery-dot-active.svg' | asset_url }}">
							<img class="store_block-product-gallery-mobile-dot-inactive" src="{{ 'store-gallery-dot-inactive.svg' | asset_url }}">
						</div>
					{% endfor %}					
				</div> {% endcomment %}
			</div>
			<div>
				<div class="store_block-product-select">
					<div class="store_block-product-select-dropdown-select store_block-product-selected">
						<span class="store_block-product-select-value">Select your Tesla model and year</span>
						<div class="store_block-product-select-arrow">
							<img src="{{ 'select_arrow_down.svg' | asset_url }}">
						</div>
					</div>
					<div class="store_block-product-select-dropdown">
						<div class="store_block-product-select-dropdown-select">
							<span class="store_block-product-select-value">Select your Tesla model and year</span>
							<div class="store_block-product-select-arrow">
								<img src="{{ 'select_arrow_up.svg' | asset_url }}">
							</div>
						</div>
						{%- for model in product.variants -%}
							<div 
								class="store_block-product-select-dropdown-item" 
								data-model_id="{{ model.id }}"
								data-sku="{{ model.sku }}" 
								data-price="{{ model.price }}"
								data-compare_at_price="{{ model.compare_at_price }}"
								data-stock="{{ model.inventory_quantity }}"
							>
								<span>{{ model.title }}</span>
								<img src="{{ 'store_model_selected.svg' | asset_url }}">
							</div>
						{%- endfor -%}
					</div>
				</div>
				<div class="store_block-add-wireless">
					<input type="checkbox" id="select-charger" class="store_block-add-wireless-checkbox" checked>
					<label for="select-charger" class="store_block-add-wireless-title">
						Add Wireless Charger <span class="store_block-add-wireless-price">+ 40 USD</span>
					</label>					
				</div>
				{% comment %} <div class="store_block-add-wireless">
					<input type="checkbox" id="select-camera" class="store_block-add-wireless-checkbox" checked>
					<label for="select-camera" class="store_block-add-wireless-title">
						Add Wireless Front Bumper Camera <span class="store_block-add-wireless-price">+ 50 USD</span>
					</label>					
				</div> {% endcomment %}
				<div class="store_block-product-order">
					<button class="store_block-product-add">Preorder now</button>
					<button class="store_block-product-add-mobile">
						<div class="store_block-product-add-mobile-text">Preorder now</div>
						<div class="store_block-product-add-mobile-total">{{ product.price | divided_by: 100 | plus: 40 }} USD</div>
					</button>
					<div class="store_block-product-order-features">
						<div class="store_block-product-order-feature">
							<div class="store_block-product-order-feature-icon">
								<img src="{{ 'feature_free_shipping.svg' | asset_url }}">
							</div>
							<div class="store_block-product-order-feature-text">
								<span class="store_block-product-order-feature-text-main">Free shipping</span> within the US
							</div>
						</div>
						<div class="store_block-product-order-feature">
							<div class="store_block-product-order-feature-icon">
								<img src="{{ 'feature_no_import.svg' | asset_url }}">
							</div>
							<div class="store_block-product-order-feature-text">
								<span class="store_block-product-order-feature-text-main">Duties and taxes</span> included in most countries*
							</div>
						</div>
						<div class="store_block-product-order-feature-subtext">
							*See <a href="/shipping-delivery" target="_blank">Shipping page</a> for details. 
						</div>
					</div>
				</div>
				<div class="store_block-product-preorder-delivery">
					Delivery: <span>March 2026</span>
				</div>
			</div>
		</div>
	</div>
	<input type="hidden" id="charger-id" value="{{ charger.id }}">				
	<input type="hidden" id="charger-variant-id" value="{{ charger.variants[0].id }}">				
	{% comment %} <input type="hidden" id="camera-variant-id" value="{{ charger.variants[0].id }}">				 {% endcomment %}
</div>

<script type="text/javascript">
	$(document).ready(function() {
		var imgnum = 0
		setGalleryImage()
		
		var galleryWrap = document.querySelector('.store_block-product-gallery-mobile')

		var startX, startY, deltaX, deltaY, listing = false

		function handleMouseDown(event) {
			event.preventDefault()
			startX = event.touches ? event.touches[0].clientX : event.clientX
			startY = event.touches ? event.touches[0].clientY : event.clientY
			deltaX = 0
			deltaY = 0
			listing = true
		}

		function handleMouseMove(event) {
		  	// if (listing) {
		  		const clientX = event.touches ? event.touches[0].clientX : event.clientX
		  		const clientY = event.touches ? event.touches[0].clientY : event.clientY
			    deltaX = clientX - startX
			    deltaY = clientY - startY
			    startX = clientX
			    startY = clientY
			    if (Math.abs(deltaX / deltaY) < 1) {
			    	listing = false
	                const scrollTop = $('body').scrollTop()
	                $('body').scrollTop(scrollTop - deltaY)
				}
			// }
		}

		function handleMouseUp() {
		    if (deltaX != 0 && listing) {
				let direction = deltaX > 0 ? 'prev' : 'next'
				handleDirection(direction)
			}
			listing = false
		}

		galleryWrap.addEventListener('mousedown', handleMouseDown)
		galleryWrap.addEventListener('mousemove', handleMouseMove/*, { once: true }*/)
		galleryWrap.addEventListener('mouseup', handleMouseUp/*, { once: true }*/)

		galleryWrap.addEventListener('touchstart', handleMouseDown)
		galleryWrap.addEventListener('touchmove', handleMouseMove/*, { once: true }*/)
		galleryWrap.addEventListener('touchend', handleMouseUp/*, { once: true }*/)

		$('.store_block-product-gallery-item').on('click', function() {
			imgnum = $(this).data('imgnum')
			$('.store_block-product-gallery-item').each(function() {
				$(this).removeClass('active')
			})
			$(this).addClass('active')
			setGalleryImage()
		})

		$('.store_block-product-gallery-mobile-dot').on('click', function() {
			imgnum = $(this).data('imgnum')
			setGalleryImage()
		})

		/*$('.store_block-product-gallery-mobile-nav').on('click', function() {
			let direction = $(this).data('direction')
		})*/

		function handleDirection(direction) {
			console.log(direction)
			if (direction == 'prev') {
				imgnum = imgnum -= 1
				if (imgnum < 0) imgnum = 5
			}
			if (direction == 'next') {
				imgnum = imgnum += 1
				if (imgnum > 5) imgnum = 0
			}
			setGalleryImage()
		}

		function setGalleryImage() {
			$('.store_block-product-gallery-main').find('img').each(function() {
				if ($(this).data('imgnum') == imgnum) $(this).show()
				else $(this).hide()
			})
			$('.store_block-product-gallery-mobile-dot').each(function() {
				if ($(this).data('imgnum') == imgnum) {
					$(this).find('.store_block-product-gallery-mobile-dot-active').show()
					$(this).find('.store_block-product-gallery-mobile-dot-inactive').hide()
				}
				else {
					$(this).find('.store_block-product-gallery-mobile-dot-active').hide()
					$(this).find('.store_block-product-gallery-mobile-dot-inactive').show()
				}
			})
		}

		var model_id = null
		// selectModel('TT22')
		$('.store_block-product-select-dropdown-select').on('click', function() {
			let dropdown = $(this).parents('.store_block-product-select').find('.store_block-product-select-dropdown')
			if ($(dropdown).is(':visible')) {
				$(dropdown).css('display', 'none')
			}
			else {
				$(dropdown).css('display', 'flex')
			}
			// $(this).parents('.store_block-product-select').find('.store_block-product-select-dropdown').toggle()
		})
		$('.store_block-product-select-dropdown-item').on('click', function() {
			let sku = $(this).data('sku')
			selectModel(sku)
		})
		$(document).click(function(event) { 
			var $target = $(event.target)
			if (!$target.closest('.store_block-product-select').length && 
				!$target.closest('.store_block-product-select-dropdown').length && 
				$('.store_block-product-select-dropdown').is(":visible")) {
				$('.store_block-product-select-dropdown').hide()
			}        
		})
		var price = null, charger_selected = true, camera_selected = true
		function selectModel(sku) {
			let model = $(`.store_block-product-select-dropdown-item[data-sku="${sku}"]`).first()
			model_id = model.data('model_id')
			$('.store_block-product-select-dropdown-item').each(function() {
				if ($(this).data('sku') == sku) $(this).addClass('store_block-product-select-dropdown-item-selected')
					else $(this).removeClass('store_block-product-select-dropdown-item-selected')
			})
			$('.store_block-product-selected').find('.store_block-product-select-value').text(model.text())
			$('.store_block-product-price-new').text((model.data('price') / 100) + ' USD')
			price = model.data('price') / 100
			setTotalPrice(price, charger_selected, camera_selected)
			if (model.data('compare_at_price')) {
				$('.store_block-product-price-old').text((model.data('compare_at_price') / 100) + ' USD')
			}
			$('.store_block-product-select').find('.store_block-product-select-dropdown').hide()
		}
		$('#select-charger').on('change', function() {
			charger_selected = $(this).prop('checked')
			setTotalPrice(price, charger_selected, camera_selected)
		})
		$('#select-camera').on('change', function() {
			camera_selected = $(this).prop('checked')
			setTotalPrice(price, charger_selected, camera_selected)
		})
		function setTotalPrice(price, charger_selected, camera_selected) {
			if (price) {
				let totalPrice = Number(price)
				if (charger_selected) totalPrice += 40
				if (camera_selected) totalPrice += 50
				$('.store_block-product-add-mobile-total').text(totalPrice + ' USD')
			}
			else {
				$('.store_block-product-add-mobile-total').text('')
			}
		}
		var cart_qty = Number({{ cart.item_count }})
		$('.store_block-product-add, .store_block-product-add-mobile').on('click', function() {
			console.log('click to add')
			if (model_id) {
				let items = [{
					'id': model_id,
					'quantity': 1
				}]
				let add_items_count = 1
				if ($('#select-charger').prop('checked') === true) {
					let charger_variant_id = $('#charger-variant-id').val()
					console.log(Number(charger_variant_id))
					items.push({
						'id': Number(charger_variant_id),
						'quantity': 1
					})
					add_items_count++
				}
				// if ($('#select-camera').prop('checked') === true) {
				// 	let camera_variant_id = $('#camera-variant-id').val()
				// 	console.log(Number(camera_variant_id))
				// 	items.push({
				// 		'id': Number(camera_variant_id),
				// 		'quantity': 1
				// 	})
				// 	add_items_count++
				// }
				console.log(items)
				let formData = {
				 	'items': items
				}
				fetch(window.Shopify.routes.root + 'cart/add.js', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json'
					},
					body: JSON.stringify(formData)
				})
				.then(response => {
				  	window.location.href = '/cart'
				})
				.catch((error) => {
				  	console.error('Error:', error)
				});
			} else {
				$('.store_block-product-select').addClass('store_block-product-select-error')
			}
		})
	})
</script>
