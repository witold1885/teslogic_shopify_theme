<style type="text/css">
    .fix-update-block {
        width: 856px;
        margin: 180px auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        row-gap: 40px;
    }
    .fix-update-title {
        width: 100%;
        color: #000;
        font-family: Manrope;
        font-size: 52px;
        font-style: normal;
        font-weight: 500;
        line-height: 64px;
        text-transform: capitalize;
        text-align: left;
    }
    .fix-update-steps {
        list-style: none;
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 32px;
        border-radius: 24px;
        border: 1px solid rgba(0, 0, 0, 0.10);
        background: #F6F6F6;
    }
    .fix-update-step:not(:first-child) {
        padding-top: 40px;
    }
    .fix-update-step:not(:last-child) {
        padding-bottom: 40px;
        border-bottom: 2px solid #D9D9D9;
    }
    .fix-update-step-marker {
        margin-right: 20px;
    }
    .fix-update-step-marker, .fix-update-step-text {
        color: #000;
        font-family: Manrope;
        font-size: 32px;
        font-style: normal;
        font-weight: 500;
        line-height: 40px;
    }
    .fix-update-step-actions, .fix-update-step-image {
        width: 100%;
        margin-top: 20px;
    }
    .fix-update-step-actions > a {
        display: flex;
        justify-content: center;
        align-items: center;
        width: fit-content;
        padding: 20px 40px;
        border-radius: 32px;
        background: #0465FD;
        color: #FFF;
        font-family: Manrope;
        font-size: 18px;
        font-style: normal;
        font-weight: 600;
        line-height: 24px;
        text-decoration: none;
        text-align: center;
    }
    .fix-update-step-actions > a:hover {
        background: #0345ED;
        color: #FFF;
    }
    @media screen and (min-width: 576px) and (max-width: 1440px) {
        .fix-update-block {
            width: calc(856 * 100vw / 1440);
            margin: calc(180 * 100vw / 1440) auto;
            row-gap: calc(40 * 100vw / 1440);
        }
        .fix-update-title {
            font-size: calc(52 * 100vw / 1440);
            line-height: calc(64 * 100vw / 1440);
        }
        .fix-update-steps {
            padding: calc(32 * 100vw / 1440);
            border-radius: calc(24 * 100vw / 1440);
        }
        .fix-update-step:not(:first-child) {
            padding-top: calc(40 * 100vw / 1440);
        }
        .fix-update-step:not(:last-child) {
            padding-bottom: calc(40 * 100vw / 1440);
        }
        .fix-update-step-marker {
            margin-right:  calc(20 * 100vw / 1440);
        }
        .fix-update-step-marker, .fix-update-step-text {
            font-size: calc(32 * 100vw / 1440);
            line-height: calc(40 * 100vw / 1440);
        }
        .fix-update-step-actions, .fix-update-step-image {
            margin-top: calc(20 * 100vw / 1440);
        }
        .fix-update-step-actions > a {
            padding: calc(20 * 100vw / 1440) calc(40 * 100vw / 1440);
            border-radius: calc(32 * 100vw / 1440);
            font-size: calc(18 * 100vw / 1440);
            line-height: calc(24 * 100vw / 1440);
        }
    }
    @media screen and (max-width: 575px) {
        .fix-update-block {
            width: calc(335 * 100vw / 375);
            margin: calc(24 * 100vw / 375) auto calc(90 * 100vw / 375);
            row-gap: calc(40 * 100vw / 375);
        }
        .fix-update-title {
            font-size: calc(32 * 100vw / 375);
            line-height: calc(40 * 100vw / 375);
        }
        .fix-update-steps {
            padding: calc(16 * 100vw / 375);
            border-radius: calc(16 * 100vw / 375);
        }
        .fix-update-step:not(:first-child) {
            padding-top: calc(24 * 100vw / 375);
        }
        .fix-update-step:not(:last-child) {
            padding-bottom: calc(24 * 100vw / 375);
        }
        .fix-update-step-marker {
            margin-right:  calc(16 * 100vw / 375);
        }
        .fix-update-step-marker, .fix-update-step-text {
            font-size: calc(24 * 100vw / 375);
            line-height: calc(32 * 100vw / 375);
        }
        .fix-update-step-text br {
            display: none;
        }
        .fix-update-step-actions, .fix-update-step-image {
            margin-top: calc(16 * 100vw / 375);
        }
        .fix-update-step-actions > a {
            width: 100%;
            padding: calc(20 * 100vw / 375) 0;
            border-radius: calc(32 * 100vw / 375);
            font-size: calc(18 * 100vw / 375);
            line-height: calc(24 * 100vw / 375);
        }
    }
</style>

<div class="fix-update">
    <div class="fix-update-block">
        <div class="fix-update-title">FIX UPDATE</div>
        <ul class="fix-update-steps">
            <li class="fix-update-step">
                <div class="fix-update-step-marker">1.</div>
                <div class="fix-update-step-text">Download the file from the link.</div>
                <div class="fix-update-step-actions">
                    <a href="https://cdn.shopify.com/s/files/1/0792/5163/6443/files/screenmate-updater-fix_04.21.apk?v=1776859540">
                        DOWNLOAD FIX UPDATE FILE
                    </a>
                </div>
            </li>
            <li class="fix-update-step">
                <div class="fix-update-step-marker">2.</div>
                <div class="fix-update-step-text">Open the Downloads folder and<br>launch the app update file.</div>
                <img class="fix-update-step-image" src={{ "fix-updates-step-2.png" | asset_url }} />
            </li>
            <li class="fix-update-step">
                <div class="fix-update-step-marker">3.</div>
                <div class="fix-update-step-text">Tap Update in the pop-up window.</div>
                <img class="fix-update-step-image" src={{ "fix-updates-step-3.png" | asset_url }} />
            </li>
            <li class="fix-update-step">
                <div class="fix-update-step-marker">4.</div>
                <div class="fix-update-step-text">Tap Settings to allow installation<br>from this source.</div>
                <img class="fix-update-step-image" src={{ "fix-updates-step-4.png" | asset_url }} />
            </li>
            <li class="fix-update-step">
                <div class="fix-update-step-marker">5.</div>
                <div class="fix-update-step-text">Turn on Allow from this source<br>for Download Manager.</div>
                <img class="fix-update-step-image" src={{ "fix-updates-step-5.png" | asset_url }} />
            </li>
            <li class="fix-update-step">
                <div class="fix-update-step-marker">6.</div>
                <div class="fix-update-step-text">In the Google Play Protect window,<br>tap More details.</div>
                <img class="fix-update-step-image" src={{ "fix-updates-step-6.png" | asset_url }} />
            </li>
            <li class="fix-update-step">
                <div class="fix-update-step-marker">7.</div>
                <div class="fix-update-step-text">Tap Install anyway to continue the installation.</div>
                <img class="fix-update-step-image" src={{ "fix-updates-step-7.png" | asset_url }} />
            </li>
            <li class="fix-update-step">
                <div class="fix-update-step-marker">8.</div>
                <div class="fix-update-step-text">When the installation is complete,<br>tap Open to launch the updated app.</div>
                <img class="fix-update-step-image" src={{ "fix-updates-step-8.png" | asset_url }} />
            </li>
        </ul>
    </div>
</div>
