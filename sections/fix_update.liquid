<style type="text/css">
    .fix-update-block {
        margin: 180px auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        row-gap: 40px;
    }
    .fix-update-title {
        color: #000;
        font-family: Manrope;
        font-size: 52px;
        font-style: normal;
        font-weight: 500;
        line-height: 64px;
        text-transform: capitalize;
    }
    .fix-update-steps {
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 32px;
        border-radius: 24px;
        border: 1px solid rgba(0, 0, 0, 0.10);
        background: #F6F6F6;
    }
    .fix-update-step {
        list-style-position: inside;
    }
    .fix-update-step:not(:first-child) {
        padding-top: 40px;
    }
    .fix-update-step:not(:last-child) {
        padding-bottom: 40px;
        border-bottom: 2px solid #D9D9D9;
    }
    .fix-update-step::marker, .fix-update-step-text {
        color: #000;
        font-family: Manrope;
        font-size: 32px;
        font-style: normal;
        font-weight: 500;
        line-height: 40px;
    }
    .fix-update-step-actions, .fix-update-step-image {
        width: 100%;
        max-width: 792px;
        margin-top: 20px;
    }
    .fix-update-step-actions > a {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px 40px;
        border-radius: 32px;
        background: #0465FD;
        color: #FFF;
        font-family: Manrope;
        font-size: 18px;
        font-style: normal;
        font-weight: 600;
        line-height: 24px;
        text-decoration: none;
    }
    .fix-update-step-actions > a:hover {
        background: #0345ED;
        color: #FFF;
    }
</style>

<div class="fix-update">
    <div class="fix-update-block">
        <div class="fix-update-title">FIX UPDATE</div>
        <ol class="fix-update-steps">
            <li class="fix-update-step">
                <span class="fix-update-step-text">Download the file from the link.</span>
                <div class="fix-update-step-actions">
                    <a href="https://cdn.shopify.com/s/files/1/0792/5163/6443/files/screenmate-updater-fix_04.21.apk?v=1776859540">
                        DOWNLOAD FIX UPDATE FILE
                    </a>
                </div>
            </li>
            <li class="fix-update-step">
                <span class="fix-update-step-text">Open the Downloads folder and<br>launch the app update file.</span>
                <img class="fix-update-step-image" src={{ "fix-updates-step-2.png" | asset_url }} />
            </li>
            <li class="fix-update-step">
                <span class="fix-update-step-text">Tap Update in the pop-up window.</span>
                <img class="fix-update-step-image" src={{ "fix-updates-step-3.png" | asset_url }} />
            </li>
            <li class="fix-update-step">
                <span class="fix-update-step-text">Tap Settings to allow installation<br>from this source.</span>
                <img class="fix-update-step-image" src={{ "fix-updates-step-4.png" | asset_url }} />
            </li>
            <li class="fix-update-step">
                <span class="fix-update-step-text">Turn on Allow from this source<br>for Download Manager.</span>
                <img class="fix-update-step-image" src={{ "fix-updates-step-5.png" | asset_url }} />
            </li>
            <li class="fix-update-step">
                <span class="fix-update-step-text">In the Google Play Protect window,<br>tap More details.</span>
                <img class="fix-update-step-image" src={{ "fix-updates-step-6.png" | asset_url }} />
            </li>
            <li class="fix-update-step">
                <span class="fix-update-step-text">Tap Install anyway to continue the installation.</span>
                <img class="fix-update-step-image" src={{ "fix-updates-step-7.png" | asset_url }} />
            </li>
            <li class="fix-update-step">
                <span class="fix-update-step-text">When the installation is complete,<br>tap Open to launch the updated app.</span>
                <img class="fix-update-step-image" src={{ "fix-updates-step-8.png" | asset_url }} />
            </li>
        </ol>
    </div>
</div>
