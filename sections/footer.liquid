<link rel="stylesheet" type="text/css" href="{{ 'footer.css' | asset_url }}">
<link rel="stylesheet" type="text/css" href="{{ 'footer-responsive.css' | asset_url }}">
<link rel="stylesheet" type="text/css" href="{{ 'subscription-popup.css' | asset_url }}">

<style>
  .footer__form-checkbox input {
    background-image: url({{ 'popup_checkbox_inactive.svg' | asset_url }});
    background-size: cover;
    background-position: center;
  }
  .footer__form-checkbox input:checked {
    background-image: url({{ 'popup_checkbox_active.svg' | asset_url }});
  }
</style>

<footer id="contacts">
  <div class="footer__form">
    <div class="footer__form-texts">
      <div class="footer__form-title">Sign Up for Our Newsletter Subscription</div>
      <div class="footer__form-subtitle">Stay informed about sales, updates <br>and new products launches.</div>
    </div>
    <div class="footer__form-fields-wrap">
      <div class="footer__form-fields">
        <div class="footer__form-field">
          <input class="footer__form-email" name="email" type="email" placeholder="Enter your e-mail adress" autocomplete="email">
          <span class="footer__form-field-error-message"></span>
        </div>
        <div class="footer__form-checkbox">
          <input id="footer__form-agree" type="checkbox">
          <label for="footer__form-agree">
            I have read and agree to the <a href="/pages/privacy" target="_blank">Privacy Policy</a>
          </label>
        </div>
      </div>
      <button class="footer__form-submit">Subscribe</button>
    </div>
  </div>
  <div class="footer__delimiter"></div>
  <div class="footer__wrap">
    <div class="footer-top">
      <div class="footer-top-left">
        <div class="logo">
          <img src="{{ 'screenmate_logo_white.svg' | asset_url }}">
        </div>
        <div class="footer-links">
          <a class="footer-links__item" href="https://apps.apple.com/am/app/teslogic-dash/id1623563438" target="_blank">
            <img src="{{ 'app_store.svg' | asset_url }}">
          </a>
          <a class="footer-links__item" href="https://play.google.com/store/apps/details?id=co.teslogic.teslogic_dash" target="_blank">
            <img src="{{ 'google_play.svg' | asset_url }}">
          </a>
        </div>
      </div>
      <div class="footer-menu">
        {% assign powermate = false %}
        {% for link in linklists.main-menu.links %}
          {% if link.title == 'Powermate' %} {% assign powermate = true %} {% endif %}
          {% if link.title != 'Accessories' and link.title != 'For customers' and link.title != 'Buy Now' %}
            <div class="footer-menu__list footer-menu__list-main-{{ forloop.index }}">
              <div class="footer-menu__list-title">
                {{ link.title }}
              </div>
              {% if link.links.size > 0 %}
                <ul class="footer-menu__list-items">
                  {% for child_link in link.links %}
                    <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}

        {% for link in linklists.main-menu.links %}
          {% if link.title == 'Accessories' %}
            <div class="footer-menu__list {% if powermate %} footer-menu__list-last {% else %} footer-menu__list-main-3 {% endif %}">
              <div class="footer-menu__list-title">
                Accessories
              </div>
              <ul class="footer-menu__list-items">
                {% for product in collections['all'].products %}
                  {% if product.handle != 'teslogic-transmitter-kit' and product.handle != 'screenmate-dash-kit' and product.handle != 'powermate-boost-kit' and product.handle != 'powermate-performance-kit' and product.handle != 'screenmate-one' %}
                    <li>
                      <a href="/products/{{ product.handle }}">{{ product.title | replace: "Screenmate", "" | replace: "Dash", "" | strip }}</a>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}

        {% unless powermate %}
          <div class="footer-menu__list footer-menu__list-last"></div>
        {% endunless %}

        <div class="footer-menu__list footer-menu__list-contacts">
          <div class="footer-menu__list-title">
            Contacts
          </div>
          <ul class="footer-menu__list-items">
            <li>SCREENMATE LLC-FZ</li>
            <li><a href="mailto:info@screenmate.co">info@screenmate.co</a></li>
            <li>
              Meydan Grandstand, 6th Floor<br>
              Meydan Road, Nad Al Sheba<br>
              Dubai, U.A.E.
            </li>
          </ul>
        </div>
        {% for link in linklists.main-menu.links %}
          {% if link.title == 'For customers' %}
            <div class="footer-menu__list footer-menu__list-customers">
              <div class="footer-menu__list-title">
                For customer
              </div>
              {% if link.links.size > 0 %}
                <ul class="footer-menu__list-items">
                  {% for child_link in link.links %}
                    <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
        <div class="footer-menu__list footer-menu__list-social">
          <div class="footer-menu__list-title">
            Social
          </div>
          <ul class="footer-menu__list-items">
            <li>
              <a href="https://www.instagram.com/screenmate.co" target="_blank">Instagram</a>
            </li>
            <li>
              <a href="https://www.facebook.com/screenmate.co" target="_blank">Facebook</a>
            </li>
            <li>
              <a href="https://www.youtube.com/@screenmatefortesla" target="_blank">YouTube</a>
            </li>
          </ul>
        </div>
        <div class="footer-menu__list footer-menu__list-last footer-menu__list-legal">
          <div class="footer-menu__list-title">
            Legal
          </div>
          <ul class="footer-menu__list-items">
            <li><a href="/privacy">Privacy Policy</a></li>
            <!-- <li>Cookie Policy</li> -->
            <li><a href="/terms">Terms of Service</a></li>
            <!-- <li>Return Policy</li> -->
          </ul>
        </div>
      </div>
      <div class="footer-links-mobile">
        <a class="footer-links__item" href="https://apps.apple.com/am/app/teslogic-dash/id1623563438" target="_blank">
          <img src="{{ 'app_store.svg' | asset_url }}">
        </a>
        <a class="footer-links__item" href="https://play.google.com/store/apps/details?id=co.teslogic.teslogic_dash" target="_blank">
          <img src="{{ 'google_play.svg' | asset_url }}">
        </a>
      </div>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-bottom">
      <div class="footer-bottom__text">
        Tesla, Model 3, Model Y, Model S, Model X are trademarks or registered trademarks of their respective holders. 
        Any references to these trademarks do not imply any affiliation or endorsement.
      </div>
      <div class="footer-bottom__right">
        <div class="footer-bottom__icons">
          <!-- 
            visa; master; paypal; amazon pay; apple pay; google pay; shop pay
          -->
          {% assign footer_icons = "Visa,Master Card,Paypal,Amazon,Apple,Google,Shopify" | split: ',' %}
          {% for icon in footer_icons %}
            <img src="{{ icon | append: '.svg' | asset_url }}" />
          {% endfor %}
        </div>
        <div class="footer-bottom__copyright">
          © {{  "now" | date: '%Y' }} Screenmate
        </div>
      </div>
    </div>
  </div>

  {%  assign models = "Model 3 ‘17-20,Model 3 ‘21-23,Model 3 Highland,Model Y ‘21-24,Model Y Juniper,Model S ‘21+,Model X ‘21+"|split:',' %}

  <div id="custom-selection-popup" class="subscription-popup-shadow">
    <div class="selection-popup">
      <video autoplay muted loop class="subscription-popup-video">
        <source src="https://cdn.shopify.com/videos/c/o/v/63070f02784841769f7dac1f57ceb0dc.mp4" type="video/mp4">
      </video>
      <div class="selection-popup-close">
        <img src="{{ 'subscription_popup_close_white.svg' | asset_url }}" alt="">
      </div>
      <div class="subscription-popup-head">
        <div class="subscription-popup-logo">
          <img src="{{ 'subscription_popup_logo_white.svg' | asset_url }}" alt="">
        </div>
        <div class="subscription-popup-info">
          <div class="subscription-popup-title">
            We’d love to make <br class="mobile">our <br class="desktop">emails more <br class="mobile">useful for you.
          </div>
          <div class="subscription-popup-subtitle">
            Tell us your Tesla model so we can send <br>you the updates that matter most.
          </div>
        </div>
      </div>
      <div class="subscription-popup-form">
        <div class="subscription-popup-fields">
          <div class="subscription-popup-field">
            <label>Tesla model:</label>
            <div class="subscription-popup-field-select">
              <span class="subscription-popup-field-select-value">Select your Tesla model and year</span>
              <div class="subscription-popup-field-select-arrow">
                <img src="{{ 'select_arrow_down_white.svg' | asset_url }}">
              </div>
              <div class="subscription-popup-field-select-dropdown">
                <div class="subscription-popup-field-select-dropdown-item" data-model="">
                  <span>Select your Tesla model and year</span>
                  <div class="subscription-popup-field-select-arrow">
                    <img src="{{ 'select_arrow_up.svg' | asset_url }}">
                  </div>
                </div>
                {%- for model in models -%}
                  <div class="subscription-popup-field-select-dropdown-item" data-model="{{ model }}">
                    <span>{{ model }}</span>
                  </div>
                {%- endfor -%}
              </div>
            </div>
            <span class="subscription-popup-field-error-message"></span>
          </div>
        </div>
        <div class="subscription-popup-buttons">
          <button class="selection-popup-submit">
            Select
          </button>
        </div>
      </div>
    </div>
  </div>

  <div id="custom-success-popup" class="subscription-popup-shadow">
    <div class="success-popup">
      <video autoplay muted loop class="subscription-popup-video">
        <source src="https://cdn.shopify.com/videos/c/o/v/63070f02784841769f7dac1f57ceb0dc.mp4" type="video/mp4">
      </video>
      <div class="success-popup-close">
        <img src="{{ 'subscription_popup_close_white.svg' | asset_url }}" alt="">
      </div>
      <div class="subscription-popup-logo">
        <img src="{{ 'subscription_popup_logo_white.svg' | asset_url }}" alt="">
      </div>
      <div class="subscription-popup-info">
        <div class="subscription-popup-title">
          Thank you <br>for subscribing!
        </div>
        <div class="subscription-popup-subtitle">
          Your discount has just <br class="mobile">landed <br class="desktop">in your inbox.
        </div>
      </div>
    </div>
  </div>

</footer>

<script type="text/javascript">
  $(document).ready(function() {
    function setSubscriptionCookie(value) {
      const date = new Date()
      date.setTime(date.getTime() + 365 * 24 * 60 * 60 * 1000)
      const expires = `expires=${date.toUTCString()}`
      document.cookie = `custom_subscription=${value}; ${expires}; path=/`
    }

    function closeCustomPopup(current, next = null) {
      $(`#custom-${current}-popup`).addClass('is-hiding')
      
      setTimeout(() => {
        $(`#custom-${current}-popup`).removeClass('is-visible is-hiding')

        if (next) {
          $(`#custom-${next}-popup`).addClass('is-visible')
        }
      }, 500)
    }

    const emailField = $('.footer__form-email').parent('.footer__form-field')
    const agreeCheckbox = $('#footer__form-agree').parent('.footer__form-checkbox')
    const modelField = $('#custom-selection-popup .subscription-popup-field-select').parent('.subscription-popup-field')

    let email, agree, selectedModel = null

    $('.footer__form-email').on('keydown', function() {
      $(emailField).removeClass('footer__form-field-error')
      $(emailField).find('.footer__form-field-error-message').empty()
    })

    $('#footer__form-agree').on('change', function() {
      $(agreeCheckbox).removeClass('footer__form-checkbox-error')
    })

    $('#custom-selection-popup .subscription-popup-field-select').on('click', function() {
      const dropdown = $(this).find('.subscription-popup-field-select-dropdown')
      console.log({ dropdown, visible: $(dropdown).is(':visible') })
      if ($(dropdown).is(':visible')) {
        $(dropdown).css('display', 'none')
      } else {
        $(dropdown).css('display', 'flex')
      }
    })

    $('#custom-selection-popup .subscription-popup-field-select-dropdown-item').on('click', function() {
      selectedModel = $(this).data('model')
      $('#custom-selection-popup .subscription-popup-field-select-value').text(selectedModel || 'Select your Tesla model and year')
      $('#custom-selection-popup .subscription-popup-field-select-dropdown-item').each(function() {
        $(this).removeClass('subscription-popup-field-select-dropdown-item-selected')
      })
      $(this).addClass('subscription-popup-field-select-dropdown-item-selected')
    })

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
    const sendMailUrl = 'https://api.teslogic.co/mail/custom-subscribe'

    const errors = {
      emptyField: 'Fill in the field',
      emailNotValid: 'Email not valid',
      emailRegistered: 'This email is already registered',
      serverError: 'An error occurred try again'
    }

    async function customSubscribe () {
      const response = await fetch(sendMailUrl, {
        method: 'post',
        body: JSON.stringify({ name: email, email, tesla_models: selectedModel ? [selectedModel] : [] }),
        headers: {'Content-Type': 'application/json'}
      })
      const data = await response.json()
      
      console.log(data)
      if (response.status == 200) {
        if (data.success) {
          setSubscriptionCookie(1)
          closeCustomPopup('selection', 'success')
        } else {
          $(emailField).addClass('footer__form-field-error')
          if (data.message == 'email_exists') {
            closeCustomPopup('selection')
            $(emailField).find('.footer__form-field-error-message').text(errors.emailRegistered)
          } else {
            $(emailField).find('.footer__form-field-error-message').text(errors.serverError)
          }
        }
      }
    }

    $('.footer__form-submit').on('click', async function () {
      $('.footer__form-field').each(function() {
        $(this).removeClass('footer__form-field-error')
        $(this).find('.footer__form-field-error-message').text('')
      })

      const email = $('.footer__form-email').val()

      if (!email) {
        $(emailField).addClass('footer__form-field-error')
        $(emailField).find('.footer__form-field-error-message').text(errors.emptyField)
        return
      }

      if (!emailRegex.test(email)) {
        $(emailField).addClass('footer__form-field-error')
        $(emailField).find('.footer__form-field-error-message').text(errors.emailNotValid)
        return
      }

      const agree = $('#footer__form-agree').prop('checked')

      console.log({ agree })

      if (!agree) {
        $(agreeCheckbox).addClass('footer__form-checkbox-error')
        return
      }

      closeCustomPopup('subscription', 'selection')
    })

    $('#custom-selection-popup .selection-popup-submit').on('click', function () {
      $('#custom-selection-popup .subscription-popup-field').each(function() {
        $(this).removeClass('subscription-popup-field-error')
        $(this).find('.subscription-popup-field-error-message').text('')
      })

      if (!selectedModel) {
        $(modelField).addClass('subscription-popup-field-error')
        $(modelField).find('.subscription-popup-field-error-message').text(errors.emptyField)
        return
      }

      customSubscribe()
    })

    $('#custom-selection-popup .selection-popup-close').on('click', function() {
      customSubscribe()
    })

    $('.success-popup-close').on('click', function() {
      closeCustomPopup('success')
    })
  })
</script>
