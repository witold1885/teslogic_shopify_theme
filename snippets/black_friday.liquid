<style>
    header#header_main {
        height: calc(810px + 810px);
    }
    .banner-desktop-wrap {
        top: unset;
        bottom: 0;
        height: 810px;
    }
    @font-face {
        font-family: 'Neue Haas Grotesk Display Pro';
        src: url({{ 'https://cdn.shopify.com/s/files/1/0611/8041/2118/files/NeueHaasDisplayMediu.ttf?v=1763466988' }}) format("truetype");
        font-weight: normal;
        font-style: normal;
    }
    .black-friday {
        background: url({{ 'black_friday_gradient.png' | asset_url }});
        background-size: cover;
        background-position-x: center;
        background-repeat: no-repeat;
        position: absolute;
        top: 0;
        z-index: 1;
        width: 100%;
        height: 810px;
    }
    .black-friday * {
        box-sizing: border-box;
    }
    .black-friday-wrap {
        position: relative;
        height: 100%;
        padding-top: 106px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
    }
    .black-friday-info {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        color: #FFFFFF;
        text-align: center;
        font-style: normal;
    }
    .black-friday-info-title {
        font-family: "Neue Haas Grotesk Display Pro";
        font-size: 96px;
        font-weight: 900;
        line-height: 112px; /* 116.667% */
        letter-spacing: 1.92px;
    }
    .black-friday-info-subtitle {
        font-family: Manrope;
        font-size: 30px;
        font-weight: 500;
        line-height: 40px; /* 133.333% */
        letter-spacing: 0.54px;
    }
    .black-friday-info-counter {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        overflow: hidden;
    }
    .black-friday-info-counter * {
        margin: 0;
        padding: 0;
    }

    .clock-display-grp {
        width: 96px;
        position: relative;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
    }
    .number-grp {
        width: auto;
        display: block;
        height: 85px;
        overflow: hidden;
    }
    .number-grp-wrp {
        width: 100%;
        position: relative;
    }
    .num {
        width: 100%;
        position: relative;
        height: 85px;
    }
    .num p {
        width: 100%;
        color: #E0E0E0;
        text-align: center;
        font-family: Manrope;
        font-size: 64px;
        font-style: normal;
        font-weight: 800;
        line-height: 82px; /* 128.125% */
        letter-spacing: 1.28px;
        text-transform: uppercase;
    }
    .number-grp.first .num p {
        text-align: right;
    }
    .number-grp.second .num p {
        text-align: left;
    }
    .clock-display-grp-label {
        width: 100px;
        color: #FFF;
        text-align: center;
        font-family: Manrope;
        font-size: 16px;
        font-style: normal;
        font-weight: 500;
        line-height: 24px; /* 150% */
        text-transform: uppercase;
    }

    .black-friday-items {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 24px;
    }
    .black-friday-item {
        position: relative;
        width: 306px;
        padding: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        border-radius: 38px;
        border: 1px solid rgba(255, 255, 255, 0.10);
        background: rgba(255, 255, 255, 0.25);
        box-shadow: 0 -4px 12px 0 rgba(255, 255, 255, 0.16) inset;
        backdrop-filter: blur(12px);

        color: #FFF;
        text-align: center;
        font-family: Manrope;
        font-size: 18px;
        font-style: normal;
        font-weight: 700;
        line-height: 28px; /* 155.556% */
    }
    .black-friday-item-discount {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        width: 80px;
        height: 80px;
        transform: rotate(5deg);
        flex-shrink: 0;
        aspect-ratio: 1/1;
        background: url({{ 'black-friday-discount-star.png' | asset_url }}) center center no-repeat;
    }
    .black-friday-item-discount > div {
        color: #1553EE;
        text-align: center;
        font-family: "Neue Haas Grotesk Display Pro";
        font-size: 22px;
        font-style: normal;
        font-weight: 700;
        line-height: 22px; /* 100% */
    }
    .black-friday-item-image {
        width: 100%;
        height: 185px;
        border-radius: 26px;
        border: 1px solid rgba(255, 255, 255, 0.10);
        /* background: url(<path-to-image>) lightgray -40.408px -21px / 127.837% 111.351% no-repeat, url(<path-to-image>) lightgray -27px -7px / 119.149% 103.784% no-repeat, url(<path-to-image>) lightgray -63.518px -204.227px / 159.297% 242.821% no-repeat; */
        overflow: hidden;
    }
    .black-friday-item-image img {
        width: 100%;
        object-fit: cover;
    }
    .black-friday-item-price {
        width: 100%;
        display: flex;
        height: 52px;
        justify-content: center;
        align-items: center;
        border-radius: 26px;
        border: 3px solid #0068FD;
        background: linear-gradient(0deg, rgba(255, 255, 255, 0.50) -728.8%, rgba(255, 255, 255, 0.00) 181.94%), rgba(255, 255, 255, 0.04);
        color: inherit;
        text-decoration: none;
        cursor: pointer;
    }
    .black-friday-item-price span {
        opacity: .5;
        text-decoration: line-through;
    }
    .black-friday-expand {
        position: absolute;
        width: 92px;
        height: 92px;
        flex-shrink: 0;
        bottom: -18px;
    }
</style>

<div class="black-friday">
    <div class="black-friday-wrap">
        <div class="black-friday-info timer">
            <div class="black-friday-info-title">Black Friday</div>
            <div class="black-friday-info-subtitle">But better — 3 days of our biggest deals</div>
            <div class="black-friday-info-counter timer--clock">
                {% assign groups = 'days,hrs,mins,secs' | split: ',' %}
                {% assign digits = 'first,second' | split: ',' %}
                {% for group in groups %}
                    <div class="{{ group }}-group clock-display-grp">
                        {% for digit in digits %}
                            <div class="{{ digit }} number-grp">
                                <div class="number-grp-wrp">
                                    {% for i in (0..9) %}
                                        <div class="num num-{{ i }}"><p>{{ i }}</p></div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                        <div class="clock-display-grp-label">{{ group }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% assign products_data = "teslogic-transmitter-kit-v2|10|Teslogic v2|#shop-now,teslogic-pro-boost-transmitter-kit|15|Teslogic Pro Boost|pro#shop-now,teslogic-pro-performace-transmitter-kit|15|Teslogic Pro Performance|pro#shop-now,teslogic-screenmate|33|Screenmate|screenmate#shop-now" | split: "," %}
        <div class="black-friday-items">
            {% for row in products_data %}
                {% assign row = row | strip %}
                {% assign fields = row | split: "|" %}

                {% assign handle = fields[0] %}
                {% assign discount = fields[1] %}
                {% assign title = fields[2] %}
                {% assign slug = fields[3] %}

                {% assign product = all_products[handle] %}
                {% assign discount_value = 100 | minus: discount %}

                <div class="black-friday-item">
                    <div class="black-friday-item-discount">
                        <div>{{ discount }} %</div>
                        <div>OFF</div>
                    </div>
                    <div class="black-friday-item-image">
                        <img
                            src="{{ 'black-friday-' | append: handle |  append: '.png' | asset_url }}"
                            alt="{{ title }}"
                        >
                    </div>
                    <div class="black-friday-item-title">{{ title }}</div>
                    <a class="black-friday-item-price" href="/{{ slug }}">
                        Buy for {{ product.price | times: discount_value | divided_by: 100 | money }}&nbsp;
                        <span>{{ product.price | money }}</span>
                    </a>
                </div>
            {% endfor %}
        </div>
        <a class="black-friday-expand" href="#header_main">
            <img src="{{ 'black-friday-expand.svg' | asset_url }}">
        </a>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/1.19.1/TweenMax.min.js"></script>

<script type="text/javascript">
    TweenLite.defaultEase = Expo.easeOut;

    initTimer("2025-11-30T23:59:59");

    function getTimeLeft (targetDate) {
        const now = new Date();
        const target = new Date(targetDate);
        let diff = Math.max(0, target - now);

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        diff -= days * 1000 * 60 * 60 * 24;

        const hours = Math.floor(diff / (1000 * 60 * 60));
        diff -= hours * 1000 * 60 * 60;

        const minutes = Math.floor(diff / (1000 * 60));
        diff -= minutes * 1000 * 60;

        const seconds = Math.floor(diff / 1000);

        return { days, hours, minutes, seconds };
    }

    function initTimer (targetDate) {
        const timerEl = document.querySelector('.timer');

        const groups = {
            days: {
                first: timerEl.querySelector('.days-group .first'),
                second: timerEl.querySelector('.days-group .second'),
            },
            hours: {
                first: timerEl.querySelector('.hrs-group .first'),
                second: timerEl.querySelector('.hrs-group .second'),
            },
            minutes: {
                first: timerEl.querySelector('.mins-group .first'),
                second: timerEl.querySelector('.mins-group .second'),
            },
            seconds: {
                first: timerEl.querySelector('.secs-group .first'),
                second: timerEl.querySelector('.secs-group .second'),
            }
        };

        function animateDigit(el, val) {
            TweenMax.killTweensOf(el.querySelector('.number-grp-wrp'));
            TweenMax.to(el.querySelector('.number-grp-wrp'), 1, {
                y: -el.querySelector('.num-' + val).offsetTop
            });
        }

        function update() {
            const t = getTimeLeft(targetDate);

            const d = String(t.days).padStart(2, "0");
            const h = String(t.hours).padStart(2, "0");
            const m = String(t.minutes).padStart(2, "0");
            const s = String(t.seconds).padStart(2, "0");

            animateDigit(groups.days.first,     d[0]);
            animateDigit(groups.days.second,    d[1]);

            animateDigit(groups.hours.first,    h[0]);
            animateDigit(groups.hours.second,   h[1]);

            animateDigit(groups.minutes.first,  m[0]);
            animateDigit(groups.minutes.second, m[1]);

            animateDigit(groups.seconds.first,  s[0]);
            animateDigit(groups.seconds.second, s[1]);

            if (t.days === 0 && t.hours === 0 && t.minutes === 0 && t.seconds === 0) {
                return;
            }

            setTimeout(update, 1000);
        }

        update();
    }

    $(document).ready(function () {
        $('.black-friday-expand').on('click', function () {
            if ($(this).attr('href') != '#') {
                e.preventDefault()
                $('.burger-menu-wrap').hide()
                $('.button-close').hide()
                $('html, body').animate({
                    scrollTop: $($(this).attr('href')).offset().top
                }, 500)
            }
        })
    })
</script>
