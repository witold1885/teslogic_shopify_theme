<style>
    header#header_main {
        height: 200vh;
    }
    .banner-desktop-wrap {
        top: unset;
        bottom: 0;
        height: 100vh;
    }
    @font-face {
        font-family: 'Neue Haas Grotesk Display Pro';
        src: url({{ 'https://cdn.shopify.com/s/files/1/0611/8041/2118/files/NeueHaasDisplayMediu.ttf?v=1763466988' }}) format("truetype");
        font-weight: normal;
        font-style: normal;
    }
    .black-friday {
        background: url({{ 'black_friday_gradient.png.png' | asset_url }});
        background-size: cover;
        background-position-x: center;
        background-repeat: no-repeat;
        position: absolute;
        top: 0;
        z-index: 1;
        width: 100%;
        height: 100vh;
    }
    .black-friday-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
        margin-top: 106px;
    }
    .black-friday-info {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        color: #FFFFFF;
        text-align: center;
        font-style: normal;
    }
    .black-friday-info-title {
        font-family: "Neue Haas Grotesk Display Pro";
        font-size: 96px;
        font-weight: 900;
        line-height: 112px; /* 116.667% */
        letter-spacing: 1.92px;
    }
    .black-friday-info-subtitle {
        font-family: Manrope;
        font-size: 30px;
        font-weight: 500;
        line-height: 40px; /* 133.333% */
        letter-spacing: 0.54px;
    }
</style>

<div class="black-friday">
    <div class="black-friday-wrap">
        <div class="black-friday-info">
            <div class="black-friday-info-title">Black Friday</div>
            <div class="black-friday-info-subtitle">But better — 3 days of our biggest deals</div>
            <div class="black-friday-info-counter">
                {% assign groups = 'days,hours,minutes,seconds' | split: ',' %}
                {% assign digits = 'first,second' | split: ',' %}
                {% for group in groups %}
                    <div class="{{ group }}-group clock-display-grp">
                        {% for digit in digits %}
                            <div class="{{ digit }} number-grp">
                                <div class="number-grp-wrp">
                                    {% for i in (0..9) %}
                                        <div class="num num-{{ i }}"><p>{{ i }}</p></div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="black-friday-items"></div>

    </div>
</div>

