<style>
    .vip-popup {
        position: fixed;
        z-index: 20;
        width: 634px;
        height: 106px;
        left: calc((100vw - 634px) / 2);
        bottom: 40px;
        padding: 20px 24px;
        display: none;
        justify-content: space-between;
        align-items: center;

        border-radius: 20px;
        border: 1px solid rgba(0, 0, 0, 0.10);
        background: radial-gradient(381.31% 59.92% at 4.6% 354.55%, rgba(22, 87, 252, 0.80) 0%, rgba(22, 87, 252, 0.00) 100%), radial-gradient(1460.37% 375.48% at 11.43% 241.41%, rgba(34, 74, 251, 0.30) 0%, rgba(34, 74, 251, 0.00) 100%), rgba(0, 0, 0, 0.40);
        box-shadow: 0 8px 24px 0 rgba(2, 41, 151, 0.40);
        backdrop-filter: blur(12px);

        box-sizing: border-box;
    }
    .vip-popup * {
        box-sizing: border-box;
    }
    .vip-popup-close {
        width: 20px;
        height: 20px;
        position: absolute;
        top: 8px;
        right: 8px;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
    }
    .vip-popup-info {
        display: flex;
        flex-direction: column;
        gap: 8px;

        color: #FFF;
        font-family: Manrope;
        font-style: normal;
    }
    .vip-popup-info > div:first-child {
        font-size: 24px;
        font-weight: 600;
        line-height: 32px; /* 133.333% */
    }
    .vip-popup-info > div:last-child {
        font-size: 16px;
        font-weight: 500;
        line-height: 20px; /* 125% */
    }
    .vip-popup-buttons > button {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 14px 28px;
        border-radius: 26px;
        background: linear-gradient(179deg, #0069FD 1.13%, #4E23F9 201.17%);
        border: none;
        outline: none;

        color: #FFF;
        text-align: center;
        font-family: Manrope;
        font-size: 18px;
        font-style: normal;
        font-weight: 600;
        line-height: 24px; /* 133.333% */
        cursor: pointer;
    }
    .vip-popup-buttons > button:hover {
        background: linear-gradient(179deg, #005FE5 1.13%, #3B0CF8 201.17%);
    }
</style>

<div id="vip-popup" class="vip-popup">
    <div id="vip-popup-close" class="vip-popup-close">
        <img src="{{ 'vip_popup_close.svg' | asset_url }}" alt="">
    </div>
    <div class="vip-popup-info">
        <div>Hey — want the best Black Friday deals?</div>
        <div>Join VIP and get early access to our biggest sale of the year.</div>
    </div>
    <div class="vip-popup-buttons">
        <button id="vip-join">Join VIP</button>
    </div>
</div>

<style>
    .join-popup {
        position: relative;
        width: 484px;
        height: 316px;
        padding: 28px 36px 24px 36px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 24px;

        border-radius: 24px;
        border: 1px solid rgba(0, 0, 0, 0.10);
        background: radial-gradient(381.31% 59.92% at 4.6% 354.55%, rgba(22, 87, 252, 0.80) 0%, rgba(22, 87, 252, 0.00) 100%), radial-gradient(1460.37% 375.48% at 11.43% 241.41%, rgba(34, 74, 251, 0.15) 0%, rgba(34, 74, 251, 0.00) 100%), rgba(0, 0, 0, 0.40);
        backdrop-filter: blur(12px);

        box-sizing: border-box;
    }
    .join-popup * {
        box-sizing: border-box;
    }
    .join-popup-info {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;

        color: #FFF;
        font-family: Manrope;
        font-style: normal;
    }
    .join-popup-info > div {
        text-align: center;
        white-space: nowrap;
    }
    .join-popup-info > div:first-child {
        font-size: 32px;
        font-weight: 600;
        line-height: 40px; /* 125% */
    }
    .join-popup-info > div:last-child {
        font-size: 18px;
        font-weight: 500;
        line-height: 24px; /* 133.333% */
    }
    .join-popup-form {
        width: 100%;
        position: relative;
    }
    .join-popup-form input {
        width: 100%;
        padding: 16px;
        font-size: 16px;
        font-weight: 400;
        line-height: 20px;
        border-radius: 6px;
        border: 1px solid #D9D9D9;
        outline: none;
        box-shadow: none;
        background: transparent;
        color: #B9B9B9;
        font-family: Manrope;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 20px; /* 125% */
    }
    .join-popup-form-error input {
        border: 1px solid #FC3E30;
    }
    .join-popup-form-error-message {
        position: absolute;
        bottom: -22px;
        color: #FC3E30;
        font-size: 14px;
        font-weight: 400;
        line-height: 20px;
    }
    .join-popup-buttons {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
    }
    .join-popup-buttons > button {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        color: #FFF;
        text-align: center;
        font-family: Manrope;
        font-style: normal;
        border: none;
        outline: none;
        cursor: pointer;
    }
    .join-popup-buttons > #join-submit {
        padding: 14px 28px;

        border-radius: 54px;
        background: linear-gradient(179deg, #0069FD 1.13%, #4E23F9 201.17%);

        font-size: 18px;
        font-weight: 600;
        line-height: 24px; /* 133.333% */
    }
    .join-popup-buttons > #join-submit:hover {
        background: linear-gradient(179deg, #005FE5 1.13%, #3B0CF8 201.17%);
    }
    .join-popup-buttons > #join-cancel {
        padding: 0;

        background: transparent;
        
        font-size: 16px;
        font-weight: 400;
        line-height: 20px; /* 125% */
        opacity: 0.5;
    }
</style>

<div id="join-popup" class="subscription-popup-shadow">
    <div class="join-popup">
        <div id="join-popup-close" class="vip-popup-close">
            <img src="{{ 'vip_popup_close.svg' | asset_url }}" alt="">
        </div>
        <div class="join-popup-info">
            <div>Early Access to Black Friday</div>
            <div>24 hours. Our best prices. Starts Nov 27.</div>
        </div>
        <div class="join-popup-form">
            <input type="email" id="join-email" placeholder="John.smith@example.com">
            <span class="join-popup-form-error-message"></span>
        </div>
        <div class="join-popup-buttons">
            <button id="join-submit">Unlock VIP Prices</button>
            <button id="join-cancel">No, thanks.</button>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function() {
        /* vip popup script */

        setTimeout(() => {
            // const cookieExists = checkSubscriptionCookie()
            // if (!cookieExists) {
                $('#vip-popup').css('display', 'flex')
            // }
        }, 1000)

        $('#vip-popup-close').on('click', function() {
            $('#vip-popup').hide()
        })

        $('#vip-join').on('click', function() {
            $('#join-popup').css('display', 'flex')
        })

        $('#join-popup-close, #join-cancel').on('click', function() {
            $('#join-popup').hide()
        })

        const form = $('.join-popup-form')

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
        const sendMailUrl = 'https://api.teslogic.co/mail/discount-subscribe'

        const errors = {
            emptyField: 'Fill in the field',
            emailNotValid: 'Email not valid',
            emailRegistered: 'This email is already registered',
            serverError: 'An error occurred try again'
        }

        $('#join-submit').on('click', function() {
            $(form).removeClass('join-popup-form-error')
            $(form).find('.join-popup-form-error-message').text('')

            const email = $('#join-email').val()

            if (!email) {
                $(form).addClass('join-popup-form-error')
                $(form).find('.join-popup-form-error-message').text(errors.emptyField)
                return
            }

            if (!emailRegex.test(email)) {
                $(form).addClass('join-popup-form-error')
                $(form).find('.join-popup-form-error-message').text(errors.emailNotValid)
                return
            }
        })
        /* vip popup script */
    })
</script>
