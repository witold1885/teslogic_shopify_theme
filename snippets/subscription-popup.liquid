<link rel="stylesheet" type="text/css" href="{{ 'subscription-popup.css' | asset_url }}">

<div id="subscription-popup" class="subscription-popup-shadow">
    <div class="subscription-popup">
        <video autoplay muted loop class="subscription-popup-video">
            <source src="https://cdn.shopify.com/videos/c/o/v/63070f02784841769f7dac1f57ceb0dc.mp4" type="video/mp4">
        </video>
        <div class="subscription-popup-close">
            <img src="{{ 'subscription_popup_close_white.svg' | asset_url }}" alt="">
        </div>
        <div class="subscription-popup-head">
            <div class="subscription-popup-logo">
                <img src="{{ 'subscription_popup_logo_white.svg' | asset_url }}" alt="">
            </div>
            <div class="subscription-popup-info">
                <div class="subscription-popup-title">
                    Your first 5% discount <br>is on us!
                </div>
                <div class="subscription-popup-subtitle">
                    Join Screenmate Community <br class="mobile">and get <br class="desktop">
                    best deals <br class="mobile">and exclusive updates.
                </div>
            </div>
        </div>
        <div class="subscription-popup-form">
            <div class="subscription-popup-fields">
                <div class="subscription-popup-field">
                    <label>E-mail:</label>
                    <input class="subscription-popup-email" type="email" placeholder="John.smith@example.com">
                    <span class="subscription-popup-field-error-message"></span>
                </div>
                <div class="subscription-popup-field">
                    <label>Tesla model:</label>
                    {% comment %} <input class="subscription-popup-email" type="email" placeholder="Select your Tesla model and year"> {% endcomment %}

					<div class="subscription-popup-field-select">
						<span class="subscription-popup-field-select-value">Select your Tesla model and year</span>
						<div class="subscription-popup-field-select-arrow">
							<img src="{{ 'select_arrow_down_white.svg' | asset_url }}">
						</div>
                        <div class="subscription-popup-field-select-dropdown">

                        </div>
					</div>
                    <span class="subscription-popup-field-error-message"></span>
                </div>
            </div>
            <div class="subscription-popup-buttons">
                <button class="subscription-popup-submit">
                    I want 5% off
                </button>
                <div class="subscription-popup-cancel">
                    I'll pay in full
                </div>
            </div>
        </div>
    </div>
</div>

<div id="success-popup" class="subscription-popup-shadow">
    <div class="success-popup">
        <video autoplay muted loop class="subscription-popup-video">
            <source src="https://cdn.shopify.com/videos/c/o/v/63070f02784841769f7dac1f57ceb0dc.mp4" type="video/mp4">
        </video>
        <div class="success-popup-close">
            <img src="{{ 'subscription_popup_close_white.svg' | asset_url }}" alt="">
        </div>
        <div class="subscription-popup-logo">
            <img src="{{ 'subscription_popup_logo_white.svg' | asset_url }}" alt="">
        </div>
        <div class="subscription-popup-info">
            <div class="subscription-popup-title">
                Thank you <br>for subscribing!
            </div>
            <div class="subscription-popup-subtitle">
                Your discount has justlanded <br>in your inbox.
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function() {
    /* subscription popup script */
    function checkSubscriptionCookie() {
        const cookies = document.cookie.split('; ')
        return cookies.some(cookie => cookie.startsWith(`discount_subscription=`))
    }

    function setSubscriptionCookie(value) {
        const date = new Date()
        date.setTime(date.getTime() + 365 * 24 * 60 * 60 * 1000)
        const expires = `expires=${date.toUTCString()}`
        document.cookie = `discount_subscription=${value}; ${expires}; path=/`
    }

    function closePopup(popupId) {
        const popup = $(popupId)
        popup.addClass('is-hiding')
        
        setTimeout(() => {
            popup.removeClass('is-visible is-hiding')
        }, 500)
    }

    setTimeout(() => {
        const cookieExists = checkSubscriptionCookie()
        if (!cookieExists) {
            $('#subscription-popup').addClass('is-visible')
        }
    }, 10000)

    $('.subscription-popup-close, .subscription-popup-cancel').on('click', function() {
        setSubscriptionCookie(0)
        closePopup('#subscription-popup')
    })

    $('.subscription-popup-field-select').on('click', function() {
        const dropdown = $(this).find('.subscription-popup-field-select-dropdown')
        const arrow = $(this).find('.subscription-popup-field-select-arrow')
        if ($(dropdown).is(':visible')) {
            $(dropdown).css('display', 'none')
            $(arrow).removeClass('subscription-popup-field-select-arrow-reverted')
        } else {
            $(dropdown).css('display', 'flex')
            $(arrow).addClass('subscription-popup-field-select-arrow-reverted')
        }
    })

    // const nameField = $('.subscription-popup-name').parent('.subscription-popup-field')
    const emailField = $('.subscription-popup-email').parent('.subscription-popup-field')

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
    const sendMailUrl = 'https://api.teslogic.co/mail/discount-subscribe'

    const errors = {
        emptyField: 'Fill in the field',
        emailNotValid: 'Email not valid',
        emailRegistered: 'This email is already registered',
        serverError: 'An error occurred try again'
    }

    $('.subscription-popup-submit').on('click', async function () {
        $('.subscription-popup-field').each(function() {
            $(this).removeClass('subscription-popup-field-error')
            $(this).find('.subscription-popup-field-error-message').text('')
        })

        // const name = $('.subscription-popup-name').val()
        const email = $('.subscription-popup-email').val()

        // if (!name) {
        //   $(nameField).addClass('subscription-popup-field-error')
        //   $(nameField).find('.subscription-popup-field-error-message').text(errors.emptyField)
        //   return
        // }

        if (!email) {
            $(emailField).addClass('subscription-popup-field-error')
            $(emailField).find('.subscription-popup-field-error-message').text(errors.emptyField)
            return
        }

        if (!emailRegex.test(email)) {
            $(emailField).addClass('subscription-popup-field-error')
            $(emailField).find('.subscription-popup-field-error-message').text(errors.emailNotValid)
            return
        }

        const response = await fetch(sendMailUrl, {
            method: 'post',
            body: JSON.stringify({ name: email, email }),
            headers: {'Content-Type': 'application/json'}
        })
        const data = await response.json()
        
        console.log(data)
        if (response.status == 200) {
            if (data.success) {
                setSubscriptionCookie(1)
                $('#subscription-popup').addClass('is-hiding')

                setTimeout(() => {
                    $('#subscription-popup').removeClass('is-visible is-hiding')
                    $('#success-popup').addClass('is-visible')
                }, 500)
            } else {
                $(emailField).addClass('subscription-popup-field-error')
                if (data.message == 'email_exists') {
                    $(emailField).find('.subscription-popup-field-error-message').text(errors.emailRegistered)
                } else {
                    $(emailField).find('.subscription-popup-field-error-message').text(errors.serverError)
                }
            }
        }
    })

    $('.success-popup-close').on('click', function() {
        closePopup('#success-popup')
    })
    /* subscription popup script */
    })
</script>
