<link rel="stylesheet" type="text/css" href="{{ 'header-country.css' | asset_url }}">

<div class="header-country" id="{{ id }}">
  <div class="header-country-button"></div>
  <div class="header-country-dropdown" style="display: none;">
    <div class="header-country-dropdown-list"></div>
  </div>
</div>

<script type="text/javascript">
  async function fetchRegions () {
    const response = await fetch('https://api.teslogic.co/api/regions')
    const data = await response.json()
    return data.regions || []
  }

  function setLocalization (country_code, action = 'changing') {
    const formData = new URLSearchParams()
    formData.append('form_type', 'localization')
    formData.append('utf8', '✓')
    formData.append('_method', 'put')
    formData.append('country_code', country_code)
    fetch('/localization', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: formData.toString()
    }).then(response => {
      if (response.ok) {
        if (action === 'changing') {
          localStorage.setItem('user_selected_country', country_code)
        }
        window.location.reload()
      }
    }).catch(error => console.error(`Error ${action} country:`, error))
  }

  $(document).ready(async function() {
    const serverCountryCode = '{{ localization.country.iso_code }}'
    const savedCountryCode = localStorage.getItem('user_selected_country')

    if (savedCountryCode && savedCountryCode !== serverCountryCode) {
      setLocalization(savedCountryCode, 'syncing')
      return
    }

    const regions = await fetchRegions()

    if (regions.length) {
      let dropdownHtml = ''
      for (const region of regions) {
        let subregionsHtml = ''
        for (const subregion of region.subregions) {
          let countriesHtml = ''
          for (const country of subregion.countries) {
            countriesHtml += `
              <div
                class="header-country-dropdown-country ${country.iso_code === serverCountryCode ? 'selected' : ''}"
                data-country_code="${country.iso_code}"
              >
                <div>
                  <img src="${country.flag}" alt="${country.iso_code}" />
                  <span>${country.name}</span>
                </div>
                <div>${country.currency_symbol}</div>
              </div>
            `
          }
          subregionsHtml += `
            <div class="header-country-dropdown-subregion">
              <div class="header-country-dropdown-subregion-name">${subregion.name}</div>
              <div class="header-country-dropdown-countries">${countriesHtml}</div>
            </div>
          `
        }
        dropdownHtml += `
          <div class="header-country-dropdown-region">
            <div class="header-country-dropdown-region-name">
              <span>${region.name}</span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 6L8 10L12 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="header-country-dropdown-subregions">${subregionsHtml}</div>
          </div>
        `
      }

      $('.header-country-dropdown-list').html(dropdownHtml)

      const countries = regions.flatMap(region => region.subregions.flatMap(subregion => subregion.countries))
      const country = countries.find(({ iso_code }) => iso_code === serverCountryCode)

      if (country) {
        $('.header-country-button').html(`
          <img src="${country.flag}" alt="${country.iso_code}" />
          <span>${country.currency_symbol}</span>
        `).css('display', 'flex')
      }
    }

    const id = '{{ id }}'

    $(`#${id} .header-country-button`).on('click', function() {
      $(`#${id} .header-country-dropdown`).toggle()
    })

    $(document).click(function(event) { 
      var $target = $(event.target)
      if (!$target.closest('.header-country').length) {
        $(`#${id} .header-country-dropdown`).hide()
      }
    })

    $(document).on('click', `#${id} .header-country-dropdown-region-name`, function() {
      const subregions = $(this).next('.header-country-dropdown-subregions')
      if ($(subregions).is(':visible')) {
        $(subregions).hide()
      } else {
        $(subregions).css('display', 'flex')
      }
    })

    $(document).on('click', `#${id} .header-country-dropdown-country.selected`, function() {
      $(`#${id} .header-country-dropdown`).hide()
    })

    $(document).on('click', `#${id} .header-country-dropdown-country:not(.selected)`, function() {
      const country_code = $(this).data('country_code')
      setLocalization(country_code)
    })
  })
</script>
